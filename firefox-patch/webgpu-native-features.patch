+namespace {
+ffi::WGPUFfiMicromapUsage ConvertMicromapUsage(
+    const dom::GPUMicromapUsage& aUsage, uint32_t aGeometry) {
+  ffi::WGPUFfiMicromapUsage usage = {};
+  usage.geometry = aGeometry;
+  usage.count = aUsage.mCount;
+  usage.subdivision_level = aUsage.mSubdivisionLevel;
+  usage.four_state = aUsage.mFormat == dom::GPUOpacityMicromapFormat::_4_state;
+  return usage;
+}
+}  // namespace
+
+already_AddRefed<Blas> Device::CreateBlas(const dom::GPUBlasDescriptor& aDesc) {
+  nsTArray<ffi::WGPUFfiMicromapUsage> micromapUsageCounts;
+  nsTArray<ffi::WGPUFfiBlasTriangleGeometrySize> sizes(
+      aDesc.mGeometries.Length());
+  for (const auto& geometry : aDesc.mGeometries) {
+    ffi::WGPUFfiBlasTriangleGeometrySize size = {};
+    size.vertex_format = ConvertVertexFormat(geometry.mVertexFormat);
+    size.vertex_count = geometry.mVertexCount;
+    size.has_index = geometry.mIndexFormat.WasPassed();
+    if (size.has_index) {
+      size.index_format =
+          geometry.mIndexFormat.Value() == dom::GPUIndexFormat::Uint32
+              ? ffi::WGPUIndexFormat_Uint32
+              : ffi::WGPUIndexFormat_Uint16;
+      size.index_count =
+          geometry.mIndexCount.WasPassed() ? geometry.mIndexCount.Value() : 0;
+    }
+    size.opaque = geometry.mOpaque;
+    size.no_duplicate_any_hit = geometry.mNoDuplicateAnyHitInvocation;
+    for (const auto& usage : geometry.mOpacityMicromapUsageCounts) {
+      micromapUsageCounts.AppendElement(
+          ConvertMicromapUsage(usage, sizes.Length()));
+    }
+    sizes.AppendElement(size);
+  }
+  nsTArray<ffi::WGPUFfiBlasAabbGeometrySize> aabbSizes(
+      aDesc.mAabbGeometries.Length());
+  for (const auto& geometry : aDesc.mAabbGeometries) {
+    ffi::WGPUFfiBlasAabbGeometrySize size = {};
+    size.primitive_count = geometry.mPrimitiveCount;
+    size.opaque = geometry.mOpaque;
+    size.no_duplicate_any_hit = geometry.mNoDuplicateAnyHitInvocation;
+    aabbSizes.AppendElement(size);
+  }
+  nsTArray<ffi::WGPUFfiBlasSphereGeometrySize> sphereSizes(
+      aDesc.mSphereGeometries.Length());
+  for (const auto& geometry : aDesc.mSphereGeometries) {
+    ffi::WGPUFfiBlasSphereGeometrySize size = {};
+    size.vertex_count = geometry.mVertexCount;
+    size.has_index = geometry.mIndexFormat.WasPassed();
+    if (size.has_index) {
+      size.index_format =
+          geometry.mIndexFormat.Value() == dom::GPUIndexFormat::Uint32
+              ? ffi::WGPUIndexFormat_Uint32
+              : ffi::WGPUIndexFormat_Uint16;
+      size.index_count =
+          geometry.mIndexCount.WasPassed() ? geometry.mIndexCount.Value() : 0;
+    }
+    size.linear_swept = geometry.mLinearSwept;
+    size.successive = geometry.mSuccessive;
+    size.chained_end_caps = geometry.mEndCaps;
+    size.opaque = geometry.mOpaque;
+    size.no_duplicate_any_hit = geometry.mNoDuplicateAnyHitInvocation;
+    sphereSizes.AppendElement(size);
+  }
+  // A BLAS holds one kind of geometry; wgpu-core reports the error if all
+  // are empty.
+  if (int(!sizes.IsEmpty()) + int(!aabbSizes.IsEmpty()) +
+          int(!sphereSizes.IsEmpty()) >
+      1) {
+    ffi::wgpu_report_validation_error(
+        GetClient(), GetId(),
+        "createBlas: a BLAS holds triangle, AABB or sphere geometries, only "
+        "one kind; the sphere and then the AABB geometries were ignored");
+    if (!sizes.IsEmpty()) {
+      aabbSizes.Clear();
+    }
+    sphereSizes.Clear();
+  }
+
+  // `wgt::AccelerationStructureFlags` bits.
+  uint32_t flags = 0;
+  if (aDesc.mPreferFastBuild) {
+    flags |= 1 << 3;
+  }
+  if (aDesc.mLowMemory) {
+    flags |= 1 << 4;
+  }
+  if (aDesc.mUseTransform) {
+    flags |= 1 << 5;
+  }
+  if (aDesc.mAllowVertexReturn) {
+    flags |= 1 << 6;
+  }
+  if (aDesc.mAllowDisableOpacityMicromaps) {
+    flags |= 1 << 7;
+  }
+  if (aDesc.mAllowMotion) {
+    flags |= 1 << 8;
+  }
+
+  webgpu::StringHelper label(aDesc.mLabel);
+  RawId id = ffi::wgpu_client_create_blas(
+      GetClient(), GetId(), label.Get(), {sizes.Elements(), sizes.Length()},
+      {aabbSizes.Elements(), aabbSizes.Length()},
+      {sphereSizes.Elements(), sphereSizes.Length()},
+      {micromapUsageCounts.Elements(), micromapUsageCounts.Length()}, flags);
+
+  RefPtr<Blas> blas = new Blas(this, id, std::move(sizes), std::move(aabbSizes),
+                               std::move(sphereSizes));
+  blas->SetLabel(aDesc.mLabel);
+  return blas.forget();
+}
