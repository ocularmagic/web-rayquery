+    fn create_ray_tracing_pipeline(
+        &self,
+        device_id: id::DeviceId,
+        id_in: id::RayTracingPipelineId,
+        desc: crate::RayTracingPipelineDescriptor<'static>,
+    ) {
+        use wgc::ray_tracing_pipeline as rtp;
+
+        let device = self.resolve_device_id(device_id);
+        let intersections = desc
+            .intersections
+            .iter()
+            .map(|i| {
+                let closest_hit = i.closest_hit.as_ref().map(|stage| self.resolve_stage(stage));
+                let any_hit = i.any_hit.as_ref().map(|stage| self.resolve_stage(stage));
+                match i.intersection.as_ref() {
+                    Some(intersection) => rtp::RayTracingIntersectionDescriptor::Procedural {
+                        intersection: self.resolve_stage(intersection),
+                        closest_hit,
+                        any_hit,
+                    },
+                    None => rtp::RayTracingIntersectionDescriptor::Triangle {
+                        closest_hit,
+                        any_hit,
+                    },
+                }
+            })
+            .collect();
+        let core_desc = rtp::RayTracingPipelineDescriptor {
+            label: desc.label.clone(),
+            layout: desc.layout.map(|id| self.resolve_pipeline_layout_id(id)),
+            ray_generation: self.resolve_stage(&desc.ray_generation),
+            misses: desc.misses.iter().map(|stage| self.resolve_stage(stage)).collect(),
+            intersections,
+            callables: desc.callables.iter().map(|stage| self.resolve_stage(stage)).collect(),
+            max_recursion_depth: desc.max_recursion_depth,
+            cache: desc.cache.and_then(|cache| self.pipeline_cache(cache)),
+        };
+        let (pipeline, error) = device.create_ray_tracing_pipeline(core_desc);
+        if let Some(error) = error {
+            device.handle_error(
+                error,
+                desc.label.as_deref(),
+                "Device::create_ray_tracing_pipeline",
+            );
+        }
+        self.ray_tracing_pipelines
+            .lock()
+            .unwrap()
+            .insert(id_in, pipeline);
+    }
