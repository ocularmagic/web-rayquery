+    /// Prototype: see `Message::DeviceQuery`.
+    fn device_query(&self, device_id: id::DeviceId, query: crate::DeviceQuery) -> Vec<u64> {
+        let device = self.resolve_device_id(device_id);
+        match query {
+            crate::DeviceQuery::ClusterBuildSizes(input) => {
+                match device.cluster_acceleration_structure_build_sizes(&input) {
+                    Ok(sizes) => vec![
+                        sizes.acceleration_structure_size,
+                        sizes.update_scratch_size,
+                        sizes.build_scratch_size,
+                    ],
+                    Err(_) => vec![0; 3],
+                }
+            }
+            crate::DeviceQuery::Addresses(resources) => {
+                let blases = self.blases.lock().unwrap();
+                resources
+                    .into_iter()
+                    .map(|resource| match resource {
+                        crate::AddressOf::Buffer(id) => device
+                            .buffer_device_address(&self.resolve_buffer_id(id))
+                            .unwrap_or(0),
+                        crate::AddressOf::Blas(id) => blases
+                            .get(&id)
+                            .and_then(|blas| device.blas_device_address(blas))
+                            .unwrap_or(0),
+                        crate::AddressOf::None => 0,
+                    })
+                    .collect()
+            }
+            crate::DeviceQuery::CooperativeVectorMatrixSize(desc) => {
+                vec![device.cooperative_vector_matrix_size(&desc).unwrap_or(0)]
+            }
+            crate::DeviceQuery::CooperativeVectorProperties => device
+                .cooperative_vector_properties()
+                .unwrap_or_default()
+                .into_iter()
+                .flat_map(|p| p.map(u64::from))
+                .collect(),
+        }
+    }
