+already_AddRefed<OpacityMicromap> Device::CreateOpacityMicromap(
+    const dom::GPUOpacityMicromapDescriptor& aDesc) {
+  nsTArray<ffi::WGPUFfiMicromapUsage> usageCounts(aDesc.mUsageCounts.Length());
+  for (const auto& usage : aDesc.mUsageCounts) {
+    usageCounts.AppendElement(ConvertMicromapUsage(usage, 0));
+  }
+  webgpu::StringHelper label(aDesc.mLabel);
+  RawId id = ffi::wgpu_client_create_opacity_micromap(
+      GetClient(), GetId(), label.Get(),
+      {usageCounts.Elements(), usageCounts.Length()}, aDesc.mPreferFastBuild);
+  RefPtr<OpacityMicromap> micromap = new OpacityMicromap(this, id);
+  micromap->SetLabel(aDesc.mLabel);
+  return micromap.forget();
+}
+
+already_AddRefed<PipelineCache> Device::CreatePipelineCache(
+    const dom::GPUPipelineCacheDescriptor& aDesc) {
+  webgpu::StringHelper label(aDesc.mLabel);
+  RawId id = 0;
+  if (aDesc.mData.WasPassed()) {
+    dom::ProcessTypedArraysFixed(
+        aDesc.mData.Value(), [&](const Span<const uint8_t>& aData) {
+          id = ffi::wgpu_client_create_pipeline_cache(
+              GetClient(), GetId(), label.Get(),
+              {aData.Elements(), aData.Length()}, true, aDesc.mFallback);
+        });
+  } else {
+    id = ffi::wgpu_client_create_pipeline_cache(GetClient(), GetId(),
+                                                label.Get(), {nullptr, 0},
+                                                false, aDesc.mFallback);
+  }
+  RefPtr<PipelineCache> cache = new PipelineCache(this, id);
+  cache->SetLabel(aDesc.mLabel);
+  return cache.forget();
+}
