+already_AddRefed<Tlas> Device::CreateTlas(const dom::GPUTlasDescriptor& aDesc) {
+  webgpu::StringHelper label(aDesc.mLabel);
+  ffi::WGPUFfiPartitionedTlasLimits partitioned = {};
+  if (aDesc.mPartitioned.WasPassed()) {
+    const auto& limits = aDesc.mPartitioned.Value();
+    partitioned.partition_count = limits.mPartitionCount;
+    partitioned.max_instance_per_partition_count =
+        limits.mMaxInstancePerPartitionCount;
+    partitioned.max_instance_in_global_partition_count =
+        limits.mMaxInstanceInGlobalPartitionCount;
+    partitioned.enable_partition_translation =
+        limits.mEnablePartitionTranslation;
+  }
+  RawId id = ffi::wgpu_client_create_tlas(
+      GetClient(), GetId(), label.Get(), aDesc.mMaxInstances,
+      aDesc.mAllowVertexReturn, aDesc.mAllowMotion,
+      aDesc.mPartitioned.WasPassed() ? &partitioned : nullptr);
+
+  RefPtr<Tlas> tlas = new Tlas(this, id, aDesc.mMaxInstances);
+  tlas->SetLabel(aDesc.mLabel);
+  return tlas.forget();
+}
