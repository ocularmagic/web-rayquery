new file mode 100644
index 000000000000..963ddfac213d
--- /dev/null
+++ b/dom/webgpu/AccelerationStructure.cpp
@@ -0,0 +1,47 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "AccelerationStructure.h"
+
+#include "Device.h"
+#include "ipc/WebGPUChild.h"
+#include "mozilla/dom/WebGPUBinding.h"
+
+namespace mozilla::webgpu {
+
+GPU_IMPL_CYCLE_COLLECTION(Blas, mParent)
+GPU_IMPL_JS_WRAP(Blas)
+
+Blas::Blas(Device* const aParent, RawId aId,
+           nsTArray<ffi::WGPUFfiBlasTriangleGeometrySize>&& aSizes,
+           nsTArray<ffi::WGPUFfiBlasAabbGeometrySize>&& aAabbSizes,
+           nsTArray<ffi::WGPUFfiBlasSphereGeometrySize>&& aSphereSizes)
+    : ObjectBase(aParent->GetChild(), aId, ffi::wgpu_client_drop_blas),
+      ChildOf(aParent),
+      mSizes(std::move(aSizes)),
+      mAabbSizes(std::move(aAabbSizes)),
+      mSphereSizes(std::move(aSphereSizes)) {}
+
+Blas::~Blas() = default;
+
+GPU_IMPL_CYCLE_COLLECTION(OpacityMicromap, mParent)
+GPU_IMPL_JS_WRAP(OpacityMicromap)
+
+OpacityMicromap::OpacityMicromap(Device* const aParent, RawId aId)
+    : ObjectBase(aParent->GetChild(), aId, ffi::wgpu_client_drop_blas),
+      ChildOf(aParent) {}
+
+OpacityMicromap::~OpacityMicromap() = default;
+
+GPU_IMPL_CYCLE_COLLECTION(Tlas, mParent)
+GPU_IMPL_JS_WRAP(Tlas)
+
+Tlas::Tlas(Device* const aParent, RawId aId, uint32_t aMaxInstances)
+    : ObjectBase(aParent->GetChild(), aId, ffi::wgpu_client_drop_tlas),
+      ChildOf(aParent),
+      mMaxInstances(aMaxInstances) {}
+
+Tlas::~Tlas() = default;
+
+}  // namespace mozilla::webgpu
diff --git a/dom/webgpu/AccelerationStructure.h b/dom/webgpu/AccelerationStructure.h
new file mode 100644
index 000000000000..d75fec2c8f36
--- /dev/null
+++ b/dom/webgpu/AccelerationStructure.h
@@ -0,0 +1,86 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Prototype: hardware ray queries (dom.webgpu.experimental-ray-query.enabled).
+
+#ifndef GPU_AccelerationStructure_H_
+#define GPU_AccelerationStructure_H_
+
+#include "ObjectModel.h"
+#include "mozilla/webgpu/WebGPUTypes.h"
+#include "mozilla/webgpu/ffi/wgpu.h"
+#include "nsTArray.h"
+#include "nsWrapperCache.h"
+
+namespace mozilla::webgpu {
+
+class Device;
+
+// Bottom-level acceleration structure (`GPUBlas`).
+class Blas final : public nsWrapperCache,
+                   public ObjectBase,
+                   public ChildOf<Device> {
+ public:
+  GPU_DECL_CYCLE_COLLECTION(Blas)
+  GPU_DECL_JS_WRAP(Blas)
+
+  Blas(Device* const aParent, RawId aId,
+       nsTArray<ffi::WGPUFfiBlasTriangleGeometrySize>&& aSizes,
+       nsTArray<ffi::WGPUFfiBlasAabbGeometrySize>&& aAabbSizes,
+       nsTArray<ffi::WGPUFfiBlasSphereGeometrySize>&& aSphereSizes);
+
+  // The geometry sizes this BLAS was created with. Builds must use them.
+  const nsTArray<ffi::WGPUFfiBlasTriangleGeometrySize>& Sizes() const {
+    return mSizes;
+  }
+  const nsTArray<ffi::WGPUFfiBlasAabbGeometrySize>& AabbSizes() const {
+    return mAabbSizes;
+  }
+  const nsTArray<ffi::WGPUFfiBlasSphereGeometrySize>& SphereSizes() const {
+    return mSphereSizes;
+  }
+
+ private:
+  virtual ~Blas();
+
+  const nsTArray<ffi::WGPUFfiBlasTriangleGeometrySize> mSizes;
+  const nsTArray<ffi::WGPUFfiBlasAabbGeometrySize> mAabbSizes;
+  const nsTArray<ffi::WGPUFfiBlasSphereGeometrySize> mSphereSizes;
+};
+
+// Prototype: `GPUOpacityMicromap`, a BLAS id in the GPU process.
+class OpacityMicromap final : public nsWrapperCache,
+                              public ObjectBase,
+                              public ChildOf<Device> {
+ public:
+  GPU_DECL_CYCLE_COLLECTION(OpacityMicromap)
+  GPU_DECL_JS_WRAP(OpacityMicromap)
+
+  OpacityMicromap(Device* const aParent, RawId aId);
+
+ private:
+  virtual ~OpacityMicromap();
+};
+
+// Top-level acceleration structure (`GPUTlas`).
+class Tlas final : public nsWrapperCache,
+                   public ObjectBase,
+                   public ChildOf<Device> {
+ public:
+  GPU_DECL_CYCLE_COLLECTION(Tlas)
+  GPU_DECL_JS_WRAP(Tlas)
+
+  Tlas(Device* const aParent, RawId aId, uint32_t aMaxInstances);
+
+  uint32_t MaxInstances() const { return mMaxInstances; }
+
+ private:
+  virtual ~Tlas();
+
+  const uint32_t mMaxInstances;
+};
+
+}  // namespace mozilla::webgpu
+
+#endif  // GPU_AccelerationStructure_H_
