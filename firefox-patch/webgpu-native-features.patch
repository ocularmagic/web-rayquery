+// Prototype: hardware ray queries.
+
+/// `GPUBufferUsage.BLAS_INPUT`: a bit WebGPU does not use (see WebGPU.webidl).
+const BLAS_INPUT_USAGE_BIT: u32 = 0x4000_0000;
+
+impl Global {
+    /// Like `device_create_buffer`, with `BLAS_INPUT_USAGE_BIT` replaced by
+    /// wgpu's native `BufferUsages::BLAS_INPUT`, which `wgpu_core_remote`
+    /// never sets.
+    fn device_create_buffer_with_blas_input(
+        &self,
+        device_id: id::DeviceId,
+        desc: &BufferDescriptor,
+        id_in: id::BufferId,
+    ) {
+        let device = self.resolve_device_id(device_id);
+        let usage = wgt::BufferUsages::from_internal_flags(
+            wgt::BufferUsagesWebGPU::from_bits_retain(desc.usage.bits() & !BLAS_INPUT_USAGE_BIT),
+            wgt::BufferUsagesWGPU::BLAS_INPUT,
+        );
+        let desc = wgc::resource::BufferDescriptor {
+            label: desc.label.as_deref().map(Cow::Borrowed),
+            size: desc.size,
+            usage,
+            mapped_at_creation: desc.mapped_at_creation,
+        };
+        let buffer = device.create_buffer(&desc);
+        self.import_buffer(buffer, id_in);
+    }
