+already_AddRefed<BindGroupLayout> RayTracingPipeline::GetBindGroupLayout(
+    uint32_t aIndex) const {
+  const RawId bglId = ffi::wgpu_client_ray_tracing_pipeline_get_bind_group_layout(
+      GetClient(), GetId(), aIndex);
+  RefPtr<BindGroupLayout> object = new BindGroupLayout(mParent, bglId);
+  return object.forget();
+}
+
+GPU_IMPL_CYCLE_COLLECTION(RayTracingPassEncoder, mParent)
+GPU_IMPL_JS_WRAP(RayTracingPassEncoder)
+
+RayTracingPassEncoder::RayTracingPassEncoder(CommandEncoder* const aParent,
+                                             const nsAString& aLabel)
+    : ChildOf(aParent),
+      mLabel(aLabel),
+      mRecorder(ffi::wgpu_client_ray_tracing_pass_create()) {}
+
+RayTracingPassEncoder::~RayTracingPassEncoder() {
+  if (mRecorder) {
+    ffi::wgpu_client_ray_tracing_pass_destroy(mRecorder);
+  }
+}
+
+void RayTracingPassEncoder::SetBindGroup(uint32_t aSlot,
+                                         BindGroup* const aBindGroup,
+                                         const uint32_t* aDynamicOffsets,
+                                         size_t aDynamicOffsetsLength) {
+  if (!mRecorder) {
+    return;
+  }
+  RawId bindGroup = 0;
+  if (aBindGroup) {
+    mUsedCanvasContexts.AppendElements(aBindGroup->GetCanvasContexts());
+    mExternalTextures.AppendElements(aBindGroup->GetExternalTextures());
+    bindGroup = aBindGroup->GetId();
+  }
+  ffi::wgpu_client_ray_tracing_pass_set_bind_group(
+      mRecorder, aSlot, bindGroup, {aDynamicOffsets, aDynamicOffsetsLength});
+}
+
+void RayTracingPassEncoder::SetBindGroup(
+    uint32_t aSlot, BindGroup* const aBindGroup,
+    const dom::Sequence<uint32_t>& aDynamicOffsets, ErrorResult& aRv) {
+  this->SetBindGroup(aSlot, aBindGroup, aDynamicOffsets.Elements(),
+                     aDynamicOffsets.Length());
+}
+
+void RayTracingPassEncoder::SetBindGroup(
+    uint32_t aSlot, BindGroup* const aBindGroup,
+    const dom::Uint32Array& aDynamicOffsetsData,
+    uint64_t aDynamicOffsetsDataStart, uint64_t aDynamicOffsetsDataLength,
+    ErrorResult& aRv) {
+  auto dynamicOffsets =
+      GetDynamicOffsetsFromArray(aDynamicOffsetsData, aDynamicOffsetsDataStart,
+                                 aDynamicOffsetsDataLength, aRv);
+
+  if (dynamicOffsets.isSome()) {
+    this->SetBindGroup(aSlot, aBindGroup, dynamicOffsets->Elements(),
+                       dynamicOffsets->Length());
+  }
+}
+
+void RayTracingPassEncoder::SetPipeline(const RayTracingPipeline& aPipeline) {
+  if (mRecorder) {
+    ffi::wgpu_client_ray_tracing_pass_set_pipeline(mRecorder,
+                                                   aPipeline.GetId());
+  }
+}
+
+void RayTracingPassEncoder::TraceRays(uint32_t aWidth, uint32_t aHeight,
+                                      uint32_t aDepth) {
+  if (mRecorder) {
+    ffi::wgpu_client_ray_tracing_pass_trace_rays(mRecorder, aWidth, aHeight,
+                                                 aDepth);
+  }
+}
+
+void RayTracingPassEncoder::TraceRaysIndirect(const Buffer& aIndirectBuffer,
+                                              uint64_t aIndirectOffset) {
+  if (mRecorder) {
+    ffi::wgpu_client_ray_tracing_pass_trace_rays_indirect(
+        mRecorder, aIndirectBuffer.GetId(), aIndirectOffset);
+  }
+}
+
+void RayTracingPassEncoder::PushDebugGroup(const nsAString& aString) {
+  if (mRecorder) {
+    const NS_ConvertUTF16toUTF8 utf8(aString);
+    ffi::wgpu_client_ray_tracing_pass_push_debug_group(mRecorder, &utf8);
+  }
+}
+
+void RayTracingPassEncoder::PopDebugGroup() {
+  if (mRecorder) {
+    ffi::wgpu_client_ray_tracing_pass_pop_debug_group(mRecorder);
+  }
+}
+
+void RayTracingPassEncoder::InsertDebugMarker(const nsAString& aString) {
+  if (mRecorder) {
+    const NS_ConvertUTF16toUTF8 utf8(aString);
+    ffi::wgpu_client_ray_tracing_pass_insert_debug_marker(mRecorder, &utf8);
+  }
+}
+
+void RayTracingPassEncoder::End() {
+  if (!mRecorder) {
+    return;
+  }
+  mParent->EndRayTracingPass(mRecorder, mLabel, mUsedCanvasContexts,
+                             mExternalTextures);
+  ffi::wgpu_client_ray_tracing_pass_destroy(mRecorder);
+  mRecorder = nullptr;
+}
+
+}  // namespace mozilla::webgpu
