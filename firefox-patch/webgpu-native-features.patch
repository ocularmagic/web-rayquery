+            vertex_stride: wgt::BufferAddress,
+            index_buffer: Option<Arc<wgc::resource::Buffer>>,
+            first_index: Option<u32>,
+            transform: Option<(Arc<wgc::resource::Buffer>, wgt::BufferAddress)>,
+            opacity_micromap: Option<rt::BlasTriangleOpacityMicromap>,
+            motion_vertex_buffer: Option<Arc<wgc::resource::Buffer>>,
+        }
+        struct AabbGeometry {
+            size: wgt::BlasAABBGeometrySizeDescriptor,
+            buffer: Arc<wgc::resource::Buffer>,
+            stride: wgt::BufferAddress,
+            primitive_offset: u32,
+        }
+        struct SphereGeometry {
+            size: wgt::BlasSphereGeometrySizeDescriptor,
+            vertex_buffer: Arc<wgc::resource::Buffer>,
+            first_vertex: u32,
+            vertex_stride: wgt::BufferAddress,
+            radius_buffer: Arc<wgc::resource::Buffer>,
+            radius_offset: wgt::BufferAddress,
+            radius_stride: wgt::BufferAddress,
+            index_buffer: Option<Arc<wgc::resource::Buffer>>,
+            first_index: Option<u32>,
+        }
+
+        let encoder = self.resolve_command_encoder_id(command_encoder_id);
+
+        // Resolve every id first.
+        let mut blas_entries = Vec::with_capacity(blas.len());
+        let mut tlas_packages = Vec::with_capacity(tlas.len());
+        {
+            let blases = self.blases.lock().unwrap();
+            let tlases = self.tlases.lock().unwrap();
+            for entry in blas {
+                let Some(blas) = blases.get(&entry.blas) else {
+                    log::error!("build_acceleration_structures: unknown BLAS {:?}", entry.blas);
+                    return;
+                };
+                let mut micromaps = Vec::new();
+                for g in &entry.geometries {
+                    let micromap = match g.opacity_micromap {
+                        Some(ref m) => {
+                            let Some(micromap) = blases.get(&m.micromap) else {
+                                log::error!("build_acceleration_structures: unknown micromap");
+                                return;
+                            };
+                            Some(rt::BlasTriangleOpacityMicromap {
+                                micromap: micromap.clone(),
+                                index_buffer: m.index_buffer.map(|id| self.resolve_buffer_id(id)),
+                                index_offset: m.index_offset,
+                                index_format: m.index_format,
+                                base_triangle: m.base_triangle,
+                            })
+                        }
+                        None => None,
+                    };
+                    micromaps.push(micromap);
+                }
+                let micromap_build = entry.opacity_micromap.map(|m| rt::BlasOpacityMicromapGeometry {
+                    data_buffer: self.resolve_buffer_id(m.data_buffer),
+                    data_offset: m.data_offset,
+                    triangle_buffer: self.resolve_buffer_id(m.triangle_buffer),
+                    triangle_offset: m.triangle_offset,
+                });
+                let geometries = entry
+                    .geometries
+                    .into_iter()
+                    .zip(micromaps)
+                    .map(|(g, opacity_micromap)| Geometry {
+                        size: g.size,
+                        vertex_buffer: self.resolve_buffer_id(g.vertex_buffer),
+                        first_vertex: g.first_vertex,
+                        vertex_stride: g.vertex_stride,
+                        index_buffer: g.index_buffer.map(|id| self.resolve_buffer_id(id)),
+                        first_index: g.first_index,
+                        transform: g
+                            .transform_buffer
+                            .map(|id| (self.resolve_buffer_id(id), g.transform_offset)),
+                        opacity_micromap,
+                        motion_vertex_buffer: g
+                            .motion_vertex_buffer
+                            .map(|id| self.resolve_buffer_id(id)),
+                    })
+                    .collect::<Vec<_>>();
+                let aabb_geometries = entry
+                    .aabb_geometries
+                    .into_iter()
+                    .map(|g| AabbGeometry {
+                        size: g.size,
+                        buffer: self.resolve_buffer_id(g.buffer),
+                        stride: g.stride,
+                        primitive_offset: g.primitive_offset,
+                    })
+                    .collect::<Vec<_>>();
+                let sphere_geometries = entry
+                    .sphere_geometries
+                    .into_iter()
+                    .map(|g| SphereGeometry {
+                        size: g.size,
+                        vertex_buffer: self.resolve_buffer_id(g.vertex_buffer),
+                        first_vertex: g.first_vertex,
+                        vertex_stride: g.vertex_stride,
+                        radius_buffer: self.resolve_buffer_id(g.radius_buffer),
+                        radius_offset: g.radius_offset,
+                        radius_stride: g.radius_stride,
+                        index_buffer: g.index_buffer.map(|id| self.resolve_buffer_id(id)),
+                        first_index: g.first_index,
+                    })
+                    .collect::<Vec<_>>();
+                blas_entries.push((
+                    blas.clone(),
+                    geometries,
+                    aabb_geometries,
+                    micromap_build,
+                    sphere_geometries,
+                ));
+            }
+            for entry in tlas {
+                let Some(tlas) = tlases.get(&entry.tlas) else {
+                    log::error!("build_acceleration_structures: unknown TLAS {:?}", entry.tlas);
+                    return;
+                };
+                let mut instances = Vec::with_capacity(entry.instances.len());
+                for instance in entry.instances {
+                    let Some(blas) = blases.get(&instance.blas) else {
+                        log::error!(
+                            "build_acceleration_structures: unknown BLAS {:?} in TLAS instance",
+                            instance.blas
+                        );
+                        return;
+                    };
+                    instances.push(Some(rt::ArcTlasInstance {
+                        blas: blas.clone(),
+                        transform: instance.transform,
+                        custom_data: instance.custom_data,
+                        mask: instance.mask,
+                        intersection_index: instance.intersection_index,
+                        flags: instance.flags,
+                        motion_transform: instance.motion_transform,
+                    }));
+                }
+                tlas_packages.push(rt::ArcTlasPackage {
+                    tlas: tlas.clone(),
+                    instances,
+                    lowest_unmodified: 0,
+                });
+            }
+        }
+
+        let blas_iter = blas_entries
+            .iter()
+            .map(|(blas, geometries, aabb_geometries, micromap_build, sphere_geometries)| rt::BlasBuildEntry {
+                blas: blas.clone(),
+                geometries: if let Some(micromap) = micromap_build {
+                    rt::BlasGeometries::OpacityMicromap(micromap.clone())
+                } else if !sphere_geometries.is_empty() {
+                    rt::BlasGeometries::SphereGeometries(Box::new(sphere_geometries.iter().map(
+                        |g| rt::BlasSphereGeometry {
+                            size: &g.size,
+                            vertex_buffer: g.vertex_buffer.clone(),
+                            first_vertex: g.first_vertex,
+                            vertex_stride: g.vertex_stride,
+                            radius_buffer: g.radius_buffer.clone(),
+                            radius_offset: g.radius_offset,
+                            radius_stride: g.radius_stride,
+                            index_buffer: g.index_buffer.clone(),
+                            first_index: g.first_index,
+                        },
+                    )))
+                } else if aabb_geometries.is_empty() {
+                    rt::BlasGeometries::TriangleGeometries(Box::new(geometries.iter().map(|g| {
+                        rt::BlasTriangleGeometry {
+                            size: &g.size,
+                            vertex_buffer: g.vertex_buffer.clone(),
+                            index_buffer: g.index_buffer.clone(),
+                            transform_buffer: g.transform.as_ref().map(|(b, _)| b.clone()),
+                            first_vertex: g.first_vertex,
+                            vertex_stride: g.vertex_stride,
+                            first_index: g.first_index,
+                            transform_buffer_offset: g.transform.as_ref().map(|&(_, o)| o),
+                            opacity_micromap: g.opacity_micromap.clone(),
+                            motion_vertex_buffer: g.motion_vertex_buffer.clone(),
+                        }
+                    })))
+                } else {
+                    rt::BlasGeometries::AabbGeometries(Box::new(aabb_geometries.iter().map(
+                        |g| rt::BlasAabbGeometry {
+                            size: &g.size,
+                            stride: g.stride,
+                            aabb_buffer: g.buffer.clone(),
+                            primitive_offset: g.primitive_offset,
+                        },
+                    )))
+                },
+            });
+        encoder.build_acceleration_structures(blas_iter, tlas_packages);
+    }
+}
