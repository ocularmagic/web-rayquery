+#[no_mangle]
+pub unsafe extern "C" fn wgpu_client_create_blas(
+    client: &Client,
+    device_id: id::DeviceId,
+    label: Option<&nsACString>,
+    sizes: FfiSlice<'_, FfiBlasTriangleGeometrySize>,
+    aabb_sizes: FfiSlice<'_, FfiBlasAabbGeometrySize>,
+    sphere_sizes: FfiSlice<'_, FfiBlasSphereGeometrySize>,
+    micromap_usage_counts: FfiSlice<'_, FfiMicromapUsage>,
+    flags: u32,
+) -> id::BlasId {
+    let id = client.blases.lock().process();
+    // `flags` are `wgt::AccelerationStructureFlags` bits; tracing speed is
+    // the default trade-off.
+    let mut flags = wgt::AccelerationStructureFlags::from_bits_truncate(flags as u16);
+    if !flags.contains(wgt::AccelerationStructureFlags::PREFER_FAST_BUILD) {
+        flags |= wgt::AccelerationStructureFlags::PREFER_FAST_TRACE;
+    }
+    let desc = wgt::CreateBlasDescriptor {
+        label: wgpu_string(label),
+        flags,
+        update_mode: wgt::AccelerationStructureUpdateMode::Build,
+    };
+    let aabb_sizes = unsafe { aabb_sizes.as_slice() };
+    let sphere_sizes = unsafe { sphere_sizes.as_slice() };
+    let sizes = if !sphere_sizes.is_empty() {
+        wgt::BlasGeometrySizeDescriptors::Spheres {
+            descriptors: sphere_sizes.iter().map(FfiBlasSphereGeometrySize::to_wgt).collect(),
+        }
+    } else if aabb_sizes.is_empty() {
+        let mut descriptors: Vec<_> = unsafe { sizes.as_slice() }
+            .iter()
+            .map(FfiBlasTriangleGeometrySize::to_wgt)
+            .collect();
+        for usage in unsafe { micromap_usage_counts.as_slice() } {
+            if let Some(descriptor) = descriptors.get_mut(usage.geometry as usize) {
+                descriptor.opacity_micromap_usage_counts.push(usage.to_wgt());
+            }
+        }
+        wgt::BlasGeometrySizeDescriptors::Triangles { descriptors }
+    } else {
+        wgt::BlasGeometrySizeDescriptors::AABBs {
+            descriptors: aabb_sizes.iter().map(FfiBlasAabbGeometrySize::to_wgt).collect(),
+        }
+    };
+    let message = Message::Device(device_id, DeviceAction::CreateBlas(id, desc, sizes));
+    client.queue_message(&message);
+    id
+}
+
+#[no_mangle]
+pub unsafe extern "C" fn wgpu_client_create_tlas(
+    client: &Client,
+    device_id: id::DeviceId,
+    label: Option<&nsACString>,
+    max_instances: u32,
+    vertex_return: bool,
+    allow_motion: bool,
+    partitioned: Option<&FfiPartitionedTlasLimits>,
+) -> id::TlasId {
+    let id = client.tlases.lock().process();
+    let mut flags = acceleration_structure_flags(vertex_return);
+    if allow_motion {
+        flags |= wgt::AccelerationStructureFlags::ALLOW_MOTION;
+    }
+    let desc = wgt::CreateTlasDescriptor {
+        label: wgpu_string(label),
+        max_instances,
+        flags,
+        update_mode: wgt::AccelerationStructureUpdateMode::Build,
+        partitioned: partitioned.map(|p| wgt::PartitionedTlasLimits {
+            instance_count: max_instances,
+            max_instance_per_partition_count: p.max_instance_per_partition_count,
+            partition_count: p.partition_count,
+            max_instance_in_global_partition_count: p.max_instance_in_global_partition_count,
+            enable_partition_translation: p.enable_partition_translation,
+        }),
+    };
+    let message = Message::Device(device_id, DeviceAction::CreateTlas(id, desc));
+    client.queue_message(&message);
+    id
+}
