+    fn run_ray_tracing_pass(
+        &self,
+        command_encoder_id: id::CommandEncoderId,
+        label: Option<String>,
+        commands: Vec<crate::RayTracingPassCommand>,
+    ) {
+        use crate::RayTracingPassCommand as C;
+
+        let encoder = self.resolve_command_encoder_id(command_encoder_id);
+        let mut pass = encoder.begin_ray_tracing_pass(&wgc::command::RayTracingPassDescriptor {
+            label: label.map(Cow::Owned),
+        });
+        for command in commands {
+            match command {
+                C::SetPipeline(id) => {
+                    let pipeline = self.ray_tracing_pipelines.lock().unwrap().get(&id).cloned();
+                    match pipeline {
+                        Some(pipeline) => pass.set_pipeline(pipeline),
+                        None => log::error!("setPipeline: unknown ray tracing pipeline {id:?}"),
+                    }
+                }
+                C::SetBindGroup {
+                    index,
+                    bind_group,
+                    offsets,
+                } => pass.set_bind_group(
+                    index,
+                    bind_group.map(|id| self.resolve_bind_group_id(id)),
+                    &offsets,
+                ),
+                C::TraceRays([x, y, z]) => pass.trace_rays(x, y, z),
+                C::TraceRaysIndirect { buffer, offset } => {
+                    pass.trace_rays_indirect(self.resolve_buffer_id(buffer), offset)
+                }
+                C::PushDebugGroup(label) => pass.push_debug_group(&label, 0),
+                C::PopDebugGroup => pass.pop_debug_group(),
+                C::InsertDebugMarker(label) => pass.insert_debug_marker(&label, 0),
+            }
+        }
+        pass.end();
+    }
