+static uint32_t ConvertCooperativeVectorComponentType(
+    dom::GPUCooperativeVectorComponentType aType) {
+  // Vulkan `VkComponentTypeKHR` values.
+  switch (aType) {
+    case dom::GPUCooperativeVectorComponentType::Float16:
+      return 0;
+    case dom::GPUCooperativeVectorComponentType::Float32:
+      return 1;
+    case dom::GPUCooperativeVectorComponentType::Sint8:
+      return 3;
+    case dom::GPUCooperativeVectorComponentType::Sint16:
+      return 4;
+    case dom::GPUCooperativeVectorComponentType::Sint32:
+      return 5;
+    case dom::GPUCooperativeVectorComponentType::Uint8:
+      return 7;
+    case dom::GPUCooperativeVectorComponentType::Uint16:
+      return 8;
+    case dom::GPUCooperativeVectorComponentType::Uint32:
+      return 9;
+    case dom::GPUCooperativeVectorComponentType::Sint8_packed:
+      return 1000491000;
+    case dom::GPUCooperativeVectorComponentType::Uint8_packed:
+      return 1000491001;
+    case dom::GPUCooperativeVectorComponentType::Float8_e4m3:
+      return 1000491002;
+    case dom::GPUCooperativeVectorComponentType::Float8_e5m2:
+      return 1000491003;
+  }
+  MOZ_CRASH("bad GPUCooperativeVectorComponentType");
+}
