+Maybe<nsTArray<uint8_t>> GetImmediatesData(
+    const dom::AllowSharedBufferSource& aData,
+    uint64_t aDataOffset, const dom::Optional<uint64_t>& aSize,
+    ErrorResult& aRv) {
+  size_t elementSize = 1;
+  if (aData.IsArrayBufferView()) {
+    const auto type = aData.GetAsArrayBufferView().Type();
+    if (type != JS::Scalar::MaxTypedArrayViewType) {
+      elementSize = JS::Scalar::byteSize(type);
+    }
+  }
+  Maybe<nsTArray<uint8_t>> result;
+  dom::ProcessTypedArraysFixed(aData, [&](const Span<const uint8_t>& aBytes) {
+    const uint64_t length = aBytes.Length() / elementSize;
+    const uint64_t count =
+        aSize.WasPassed() ? aSize.Value()
+                          : (aDataOffset <= length ? length - aDataOffset : 0);
+    if (aDataOffset > length || count > length - aDataOffset) {
+      aRv.ThrowOperationError("setImmediates: data offset and size out of range");
+      return;
+    }
+    result.emplace();
+    result->AppendElements(aBytes.Subspan(aDataOffset * elementSize,
+                                          count * elementSize));
+  });
+  return result;
+}
