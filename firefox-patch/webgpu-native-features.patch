+// Prototype: ray tracing pipelines (`wgpu-ray-tracing-pipelines`).
+
+/// `GPUShaderStage` bits for the ray tracing stages (see WebGPU.webidl).
+const SHADER_STAGE_RAY_GENERATION: u32 = 0x100;
+const SHADER_STAGE_MISS: u32 = 0x200;
+const SHADER_STAGE_CLOSEST_HIT: u32 = 0x400;
+const SHADER_STAGE_ANY_HIT: u32 = 0x800;
+// Prototype: mesh shader stages.
+const SHADER_STAGE_TASK: u32 = 0x1000;
+const SHADER_STAGE_MESH: u32 = 0x2000;
+const SHADER_STAGE_INTERSECTION: u32 = 0x4000;
+const SHADER_STAGE_CALLABLE: u32 = 0x8000;
+
+/// The wgpu-native shader stages in a `GPUShaderStageFlags` value.
+fn native_shader_stages(bits: u32) -> wgt::ShaderStagesWGPU {
+    let mut stages = wgt::ShaderStagesWGPU::empty();
+    for (bit, stage) in [
+        (SHADER_STAGE_RAY_GENERATION, wgt::ShaderStagesWGPU::RAY_GENERATION),
+        (SHADER_STAGE_MISS, wgt::ShaderStagesWGPU::MISS),
+        (SHADER_STAGE_CLOSEST_HIT, wgt::ShaderStagesWGPU::CLOSEST_HIT),
+        (SHADER_STAGE_ANY_HIT, wgt::ShaderStagesWGPU::ANY_HIT),
+        (SHADER_STAGE_TASK, wgt::ShaderStagesWGPU::TASK),
+        (SHADER_STAGE_MESH, wgt::ShaderStagesWGPU::MESH),
+        (SHADER_STAGE_INTERSECTION, wgt::ShaderStagesWGPU::INTERSECTION),
+        (SHADER_STAGE_CALLABLE, wgt::ShaderStagesWGPU::CALLABLE),
+    ] {
+        if bits & bit != 0 {
+            stages |= stage;
+        }
+    }
+    stages
+}
