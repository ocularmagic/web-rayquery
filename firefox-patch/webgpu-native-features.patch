+#[repr(C)]
+pub struct FfiRayTracingIntersection<'a> {
+    pub closest_hit: Option<&'a FfiProgrammableStageDescriptor<'a>>,
+    pub any_hit: Option<&'a FfiProgrammableStageDescriptor<'a>>,
+    /// Makes this a procedural hit group, for AABB geometry.
+    pub intersection: Option<&'a FfiProgrammableStageDescriptor<'a>>,
+}
+
+#[repr(C)]
+pub struct FfiRayTracingPipelineDescriptor<'a> {
+    pub label: Option<&'a nsACString>,
+    /// `None` for `"auto"`.
+    pub layout: Option<id::PipelineLayoutId>,
+    pub ray_generation: FfiProgrammableStageDescriptor<'a>,
+    /// Chosen by `traceRay`'s miss index.
+    pub misses: FfiSlice<'a, FfiProgrammableStageDescriptor<'a>>,
+    pub intersections: FfiSlice<'a, FfiRayTracingIntersection<'a>>,
+    /// Chosen by `executeCallable`'s index.
+    pub callables: FfiSlice<'a, FfiProgrammableStageDescriptor<'a>>,
+    pub max_recursion_depth: u32,
+    /// "wgpu-pipeline-cache"; 0 for none.
+    pub cache: Option<id::PipelineCacheId>,
+}
+
+#[no_mangle]
+pub unsafe extern "C" fn wgpu_client_create_ray_tracing_pipeline(
+    client: &Client,
+    device_id: id::DeviceId,
+    desc: &FfiRayTracingPipelineDescriptor,
+) -> id::RayTracingPipelineId {
+    let id = client.ray_tracing_pipelines.lock().process();
+    let intersections = unsafe { desc.intersections.as_slice() }
+        .iter()
+        .map(|i| crate::RayTracingIntersection {
+            closest_hit: i.closest_hit.map(|stage| stage.to_wgpu()),
+            any_hit: i.any_hit.map(|stage| stage.to_wgpu()),
+            intersection: i.intersection.map(|stage| stage.to_wgpu()),
+        })
+        .collect();
+    let wgpu_desc = crate::RayTracingPipelineDescriptor {
+        label: wgpu_string(desc.label),
+        layout: desc.layout,
+        ray_generation: desc.ray_generation.to_wgpu(),
+        misses: unsafe { desc.misses.as_slice() }
+            .iter()
+            .map(|stage| stage.to_wgpu())
+            .collect(),
+        intersections,
+        callables: unsafe { desc.callables.as_slice() }
+            .iter()
+            .map(|stage| stage.to_wgpu())
+            .collect(),
+        max_recursion_depth: desc.max_recursion_depth,
+        cache: desc.cache,
+    };
+    let message = Message::Device(
+        device_id,
+        DeviceAction::CreateRayTracingPipeline(id, wgpu_desc),
+    );
+    client.queue_message(&message);
+    id
+}
