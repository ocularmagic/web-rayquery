+ffi::WGPUFfiCooperativeVectorMatrixDescriptor
+ConvertCooperativeVectorMatrixDescriptor(
+    const dom::GPUCooperativeVectorMatrixDescriptor& aDesc) {
+  auto format = [](const dom::GPUCooperativeVectorMatrixFormat& aFormat) {
+    ffi::WGPUFfiCooperativeVectorMatrixFormat result = {};
+    result.component_type =
+        ConvertCooperativeVectorComponentType(aFormat.mComponentType);
+    // The layouts list Vulkan's values in order.
+    result.layout = static_cast<uint32_t>(aFormat.mLayout);
+    result.stride = aFormat.mStride;
+    return result;
+  };
+  ffi::WGPUFfiCooperativeVectorMatrixDescriptor desc = {};
+  desc.rows = aDesc.mRows;
+  desc.columns = aDesc.mColumns;
+  desc.src = format(aDesc.mSrc);
+  desc.dst = format(aDesc.mDst);
+  return desc;
+}
