+    use wgt::ComponentSwizzle as S;
+    let pick = |c: u8, identity: S| match c {
+        b'r' => S::R,
+        b'g' => S::G,
+        b'b' => S::B,
+        b'a' => S::A,
+        b'0' => S::Zero,
