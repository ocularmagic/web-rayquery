+/// Prototype: a cluster acceleration structure operation's shape. `operation`,
+/// `mode` and `moved_type` count from 0 in `wgt`'s variant order.
+#[repr(C)]
+pub struct FfiClusterInput {
+    pub max_acceleration_structure_count: u32,
+    pub prefer_fast_trace: bool,
+    pub prefer_fast_build: bool,
+    pub operation: u32,
+    pub mode: u32,
+    pub moved_type: u32,
+    pub no_move_overlap: bool,
+    pub max_moved_bytes: u64,
+    pub max_total_cluster_count: u32,
+    pub max_cluster_count_per_acceleration_structure: u32,
+    pub vertex_format: wgt::VertexFormat,
+    pub max_geometry_index_value: u32,
+    pub max_cluster_unique_geometry_count: u32,
+    pub max_cluster_triangle_count: u32,
+    pub max_cluster_vertex_count: u32,
+    pub max_total_triangle_count: u32,
+    pub max_total_vertex_count: u32,
+    pub min_position_truncate_bit_count: u32,
+}
+
+impl FfiClusterInput {
+    fn to_wgt(&self) -> wgt::ClusterAccelerationStructureInput {
+        use wgt::ClusterOperation as Op;
+        let mut flags = wgt::AccelerationStructureFlags::empty();
+        flags.set(
+            wgt::AccelerationStructureFlags::PREFER_FAST_TRACE,
+            self.prefer_fast_trace,
+        );
+        flags.set(
+            wgt::AccelerationStructureFlags::PREFER_FAST_BUILD,
+            self.prefer_fast_build,
+        );
+        let triangles = wgt::TriangleClusterLimits {
+            vertex_format: self.vertex_format,
+            max_geometry_index_value: self.max_geometry_index_value,
+            max_cluster_unique_geometry_count: self.max_cluster_unique_geometry_count,
+            max_cluster_triangle_count: self.max_cluster_triangle_count,
+            max_cluster_vertex_count: self.max_cluster_vertex_count,
+            max_total_triangle_count: self.max_total_triangle_count,
+            max_total_vertex_count: self.max_total_vertex_count,
+            min_position_truncate_bit_count: self.min_position_truncate_bit_count,
+        };
+        let operation = match self.operation {
+            0 => Op::MoveObjects {
+                moved: match self.moved_type {
+                    0 => wgt::ClusterAccelerationStructureType::ClustersBottomLevel,
+                    1 => wgt::ClusterAccelerationStructureType::TriangleCluster,
+                    _ => wgt::ClusterAccelerationStructureType::TriangleClusterTemplate,
+                },
+                no_move_overlap: self.no_move_overlap,
+                max_moved_bytes: self.max_moved_bytes,
+            },
+            1 => Op::BuildClustersBottomLevel {
+                max_total_cluster_count: self.max_total_cluster_count,
+                max_cluster_count_per_acceleration_structure: self
+                    .max_cluster_count_per_acceleration_structure,
+            },
+            2 => Op::BuildTriangleCluster(triangles),
+            3 => Op::BuildTriangleClusterTemplate(triangles),
+            4 => Op::InstantiateTriangleCluster(triangles),
+            _ => Op::GetClusterTemplateIndices(triangles),
+        };
+        wgt::ClusterAccelerationStructureInput {
+            max_acceleration_structure_count: self.max_acceleration_structure_count,
+            flags,
+            operation,
+            mode: match self.mode {
+                0 => wgt::ClusterOperationMode::ImplicitDestinations,
+                1 => wgt::ClusterOperationMode::ExplicitDestinations,
+                _ => wgt::ClusterOperationMode::ComputeSizes,
+            },
+        }
+    }
+}
