+already_AddRefed<dom::Promise> Device::GetDeviceAddresses(
+    const dom::Sequence<dom::OwningGPUBufferOrGPUBlas>& aResources,
+    ErrorResult& aRv) {
+  RefPtr<dom::Promise> promise = dom::Promise::Create(GetParentObject(), aRv);
+  if (aRv.Failed()) {
+    return nullptr;
+  }
+  nsTArray<ffi::WGPUFfiAddressOf> resources(aResources.Length());
+  for (const auto& resource : aResources) {
+    ffi::WGPUFfiAddressOf address = {};
+    if (resource.IsGPUBuffer()) {
+      address.buffer = resource.GetAsGPUBuffer()->GetId();
+    } else {
+      address.blas = resource.GetAsGPUBlas()->GetId();
+    }
+    resources.AppendElement(address);
+  }
+  ffi::wgpu_client_device_get_addresses(
+      GetClient(), GetId(), {resources.Elements(), resources.Length()});
+  GetChild()->EnqueueDeviceQueryPromise(RefPtr{promise});
+  return promise.forget();
+}
