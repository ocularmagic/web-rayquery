+    /// Runs a render pass call `wgpu_core_remote` has no method for, on the
+    /// pass it holds.
+    fn run_native_render_command(
+        &self,
+        pass_id: id::RenderPassEncoderId,
+        command: crate::RenderPassNativeCommand,
+    ) {
+        use crate::RenderPassNativeCommand as C;
+
+        let mut pass = self.render_pass_remove(pass_id);
+        match command {
+            C::DrawMeshTasks([x, y, z]) => pass.draw_mesh_tasks(x, y, z),
+            C::DrawMeshTasksIndirect { buffer, offset } => {
+                pass.draw_mesh_tasks_indirect(self.resolve_buffer_id(buffer), offset)
+            }
+            C::MultiDrawIndirect {
+                buffer,
+                offset,
+                count,
+                indexed: false,
+            } => pass.multi_draw_indirect(self.resolve_buffer_id(buffer), offset, count),
+            C::MultiDrawIndirect {
+                buffer,
+                offset,
+                count,
+                indexed: true,
+            } => pass.multi_draw_indexed_indirect(self.resolve_buffer_id(buffer), offset, count),
+            C::MultiDrawIndirectCount {
+                buffer,
+                offset,
+                count_buffer,
+                count_offset,
+                max_count,
+                indexed,
+            } => {
+                let buffer = self.resolve_buffer_id(buffer);
+                let count_buffer = self.resolve_buffer_id(count_buffer);
+                if indexed {
+                    pass.multi_draw_indexed_indirect_count(
+                        buffer,
+                        offset,
+                        count_buffer,
+                        count_offset,
+                        max_count,
+                    )
+                } else {
+                    pass.multi_draw_indirect_count(
+                        buffer,
+                        offset,
+                        count_buffer,
+                        count_offset,
+                        max_count,
+                    )
+                }
+            }
+        }
+        self.import_render_pass(pass, pass_id);
+    }
