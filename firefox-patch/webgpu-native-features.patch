+    fn ray_tracing_pipeline_get_bind_group_layout(
+        &self,
+        pipeline_id: id::RayTracingPipelineId,
+        index: u32,
+        id_in: id::BindGroupLayoutId,
+    ) {
+        let Some(pipeline) = self
+            .ray_tracing_pipelines
+            .lock()
+            .unwrap()
+            .get(&pipeline_id)
+            .cloned()
+        else {
+            log::error!("getBindGroupLayout: unknown ray tracing pipeline {pipeline_id:?}");
+            return;
+        };
+        use wgc::resource::ParentDevice as _;
+
+        let (layout, error) = pipeline.get_bind_group_layout(index);
+        if let Some(error) = error {
+            pipeline.device().handle_error(
+                error,
+                None,
+                "RayTracingPipeline::get_bind_group_layout",
+            );
+        }
+        self.import_bind_group_layout(layout, id_in);
+    }
