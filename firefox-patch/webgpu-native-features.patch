+#[no_mangle]
+pub unsafe extern "C" fn wgpu_client_command_encoder_build_acceleration_structures(
+    client: &Client,
+    command_encoder_id: id::CommandEncoderId,
+    blas: FfiSlice<'_, FfiBlasBuildEntry<'_>>,
+    tlas: FfiSlice<'_, FfiTlasBuildEntry<'_>>,
+) {
+    let blas = unsafe { blas.as_slice() }
+        .iter()
+        .map(|entry| crate::BlasBuildEntry {
+            blas: entry.blas,
+            geometries: unsafe { entry.geometries.as_slice() }
+                .iter()
+                .map(|g| crate::BlasTriangleGeometry {
+                    size: g.size.to_wgt(),
+                    vertex_buffer: g.vertex_buffer,
+                    first_vertex: g.first_vertex,
+                    vertex_stride: g.vertex_stride,
+                    index_buffer: g.index_buffer,
+                    first_index: g.index_buffer.map(|_| g.first_index),
+                    transform_buffer: g.transform_buffer,
+                    transform_offset: g.transform_offset,
+                    motion_vertex_buffer: g.motion_vertex_buffer,
+                    opacity_micromap: g.opacity_micromap.map(|micromap| {
+                        crate::TriangleOpacityMicromap {
+                            micromap,
+                            index_buffer: g.micromap_index_buffer,
+                            index_offset: g.micromap_index_offset,
+                            index_format: g.micromap_index_format,
+                            base_triangle: g.micromap_base_triangle,
+                        }
+                    }),
+                })
+                .collect(),
+            aabb_geometries: unsafe { entry.aabb_geometries.as_slice() }
+                .iter()
+                .map(|g| crate::BlasAabbGeometry {
+                    size: g.size.to_wgt(),
+                    buffer: g.buffer,
+                    stride: g.stride,
+                    primitive_offset: g.primitive_offset,
+                })
+                .collect(),
+            sphere_geometries: unsafe { entry.sphere_geometries.as_slice() }
+                .iter()
+                .map(|g| crate::BlasSphereGeometry {
+                    size: g.size.to_wgt(),
+                    vertex_buffer: g.vertex_buffer,
+                    first_vertex: g.first_vertex,
+                    vertex_stride: g.vertex_stride,
+                    radius_buffer: g.radius_buffer,
+                    radius_offset: g.radius_offset,
+                    radius_stride: g.radius_stride,
+                    index_buffer: g.index_buffer,
+                    first_index: g.index_buffer.map(|_| g.first_index),
+                })
+                .collect(),
+            opacity_micromap: match (entry.micromap_data_buffer, entry.micromap_triangle_buffer) {
+                (Some(data_buffer), Some(triangle_buffer)) => Some(crate::OpacityMicromapBuild {
+                    data_buffer,
+                    data_offset: entry.micromap_data_offset,
+                    triangle_buffer,
+                    triangle_offset: entry.micromap_triangle_offset,
+                }),
+                _ => None,
+            },
+        })
+        .collect();
+    let tlas = unsafe { tlas.as_slice() }
+        .iter()
+        .map(|entry| crate::TlasBuildEntry {
+            tlas: entry.tlas,
+            instances: unsafe { entry.instances.as_slice() }
+                .iter()
+                .map(|i| crate::TlasInstance {
+                    blas: i.blas,
+                    transform: i.transform,
+                    custom_data: i.custom_data,
+                    mask: i.mask,
+                    intersection_index: i.intersection_index,
+                    flags: i.flags,
+                    motion_transform: i.has_motion_transform.then_some(i.motion_transform),
+                })
+                .collect(),
+        })
+        .collect();
+    let message = Message::BuildAccelerationStructures {
+        command_encoder_id,
+        blas,
+        tlas,
+    };
+    client.queue_message(&message);
+}
