+// Prototype: ray tracing pipelines. wgpu-core validates the feature, the
+// shaders and the layout, and reports errors to the device.
+
+namespace {
+// Keeps the strings a `WGPUFfiProgrammableStageDescriptor` points into alive.
+struct StageStrings {
+  nsCString mEntryPoint;
+  nsTArray<nsCString> mConstantKeys;
+  nsTArray<ffi::WGPUConstantEntry> mConstants;
+};
+
+ffi::WGPUFfiProgrammableStageDescriptor ConvertRayTracingStage(
+    const dom::GPUProgrammableStage& aStage, StageStrings& aStrings) {
+  ffi::WGPUFfiProgrammableStageDescriptor stage = {};
+  stage.module = aStage.mModule->GetId();
+  if (aStage.mEntryPoint.WasPassed()) {
+    CopyUTF16toUTF8(aStage.mEntryPoint.Value(), aStrings.mEntryPoint);
+    stage.entry_point = aStrings.mEntryPoint.get();
+  }
+  if (aStage.mConstants.WasPassed()) {
+    const auto& entries = aStage.mConstants.Value().Entries();
+    aStrings.mConstantKeys.SetCapacity(entries.Length());
+    aStrings.mConstants.SetCapacity(entries.Length());
+    for (const auto& entry : entries) {
+      ffi::WGPUConstantEntry constant = {};
+      constant.key =
+          aStrings.mConstantKeys.AppendElement(NS_ConvertUTF16toUTF8(entry.mKey))
+              ->get();
+      constant.value = entry.mValue;
+      aStrings.mConstants.AppendElement(constant);
+    }
+    stage.constants = {aStrings.mConstants.Elements(),
+                       aStrings.mConstants.Length()};
+  }
+  return stage;
+}
+}  // namespace
+
+already_AddRefed<RayTracingPipeline> Device::CreateRayTracingPipeline(
+    const dom::GPURayTracingPipelineDescriptor& aDesc) {
+  // One `StageStrings` per stage; `UniquePtr`s keep their addresses stable.
+  nsTArray<UniquePtr<StageStrings>> strings;
+  const auto convert = [&](const dom::GPUProgrammableStage& aStage) {
+    auto& stageStrings = *strings.AppendElement(std::make_unique<StageStrings>());
+    return ConvertRayTracingStage(aStage, *stageStrings);
+  };
+
+  ffi::WGPUFfiRayTracingPipelineDescriptor desc = {};
+  webgpu::StringHelper label(aDesc.mLabel);
+  desc.label = label.Get();
+  if (aDesc.mLayout.IsGPUPipelineLayout()) {
+    desc.layout = aDesc.mLayout.GetAsGPUPipelineLayout()->GetId();
+  }  // Otherwise "auto": 0.
+  desc.ray_generation = convert(aDesc.mRayGeneration);
+  nsTArray<ffi::WGPUFfiProgrammableStageDescriptor> misses;
+  if (aDesc.mMiss.IsGPUProgrammableStage()) {
+    misses.AppendElement(convert(aDesc.mMiss.GetAsGPUProgrammableStage()));
+  } else {
+    for (const auto& miss : aDesc.mMiss.GetAsGPUProgrammableStageSequence()) {
+      misses.AppendElement(convert(miss));
+    }
+  }
+  desc.misses = {misses.Elements(), misses.Length()};
+  nsTArray<ffi::WGPUFfiProgrammableStageDescriptor> callables;
+  for (const auto& callable : aDesc.mCallables) {
+    callables.AppendElement(convert(callable));
+  }
+  desc.callables = {callables.Elements(), callables.Length()};
+
+  // Reserved up front: the hit groups point into `groupStages`.
+  nsTArray<ffi::WGPUFfiProgrammableStageDescriptor> groupStages(
+      aDesc.mIntersections.Length() * 3);
+  nsTArray<ffi::WGPUFfiRayTracingIntersection> intersections(
+      aDesc.mIntersections.Length());
+  const auto optionalStage = [&](const dom::Optional<dom::GPUProgrammableStage>&
+                                     aStage)
+      -> const ffi::WGPUFfiProgrammableStageDescriptor* {
+    return aStage.WasPassed() ? groupStages.AppendElement(convert(aStage.Value()))
+                              : nullptr;
+  };
+  for (const auto& group : aDesc.mIntersections) {
+    ffi::WGPUFfiRayTracingIntersection intersection = {};
+    intersection.closest_hit = optionalStage(group.mClosestHit);
+    intersection.any_hit = optionalStage(group.mAnyHit);
+    intersection.intersection = optionalStage(group.mIntersection);
+    intersections.AppendElement(intersection);
+  }
+  desc.intersections = {intersections.Elements(), intersections.Length()};
+  desc.max_recursion_depth = aDesc.mMaxRecursionDepth;
+  if (aDesc.mCache.WasPassed()) {
+    desc.cache = aDesc.mCache.Value().GetId();
+  }
+
+  RawId id =
+      ffi::wgpu_client_create_ray_tracing_pipeline(GetClient(), GetId(), &desc);
+  RefPtr<RayTracingPipeline> pipeline = new RayTracingPipeline(this, id);
+  pipeline->SetLabel(aDesc.mLabel);
+  return pipeline.forget();
+}
