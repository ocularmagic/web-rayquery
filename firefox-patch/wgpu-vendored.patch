+        input: &wgt::ClusterAccelerationStructureInput,
+        storage: &mut alloc::vec::Vec<alloc::boxed::Box<[u64]>>,
+    ) -> (i32, *mut c_void) {
+        fn boxed<T>(value: T, storage: &mut alloc::vec::Vec<alloc::boxed::Box<[u64]>>) -> *mut c_void {
+            // A `u64` box sized and aligned for `T`.
+            let words = core::mem::size_of::<T>().div_ceil(8);
+            let mut slot = alloc::vec![0u64; words].into_boxed_slice();
+            let pointer = slot.as_mut_ptr() as *mut T;
+            unsafe { pointer.write(value) };
+            storage.push(slot);
+            pointer as *mut c_void
+        }
+        let triangles = |limits: &wgt::TriangleClusterLimits| TriangleClusterInput {
+            s_type: vk::StructureType::from_raw(1000569003),
+            p_next: core::ptr::null_mut(),
+            vertex_format: super::conv::map_vertex_format(limits.vertex_format),
+            max_geometry_index_value: limits.max_geometry_index_value,
+            max_cluster_unique_geometry_count: limits.max_cluster_unique_geometry_count,
+            max_cluster_triangle_count: limits.max_cluster_triangle_count,
+            max_cluster_vertex_count: limits.max_cluster_vertex_count,
+            max_total_triangle_count: limits.max_total_triangle_count,
+            max_total_vertex_count: limits.max_total_vertex_count,
+            min_position_truncate_bit_count: limits.min_position_truncate_bit_count,
+        };
+        use wgt::ClusterOperation as Op;
+        match input.operation {
+            Op::MoveObjects {
+                moved,
+                no_move_overlap,
+                max_moved_bytes,
+            } => (
+                0,
+                boxed(
+                    MoveObjectsInput {
+                        s_type: vk::StructureType::from_raw(1000569004),
+                        p_next: core::ptr::null_mut(),
+                        ty: match moved {
+                            wgt::ClusterAccelerationStructureType::ClustersBottomLevel => 0,
+                            wgt::ClusterAccelerationStructureType::TriangleCluster => 1,
+                            wgt::ClusterAccelerationStructureType::TriangleClusterTemplate => 2,
+                        },
+                        no_move_overlap: no_move_overlap as vk::Bool32,
+                        max_moved_bytes,
+                    },
+                    storage,
+                ),
+            ),
+            Op::BuildClustersBottomLevel {
+                max_total_cluster_count,
+                max_cluster_count_per_acceleration_structure,
+            } => (
+                1,
+                boxed(
+                    ClustersBottomLevelInput {
+                        s_type: vk::StructureType::from_raw(1000569002),
+                        p_next: core::ptr::null_mut(),
+                        max_total_cluster_count,
+                        max_cluster_count_per_acceleration_structure,
+                    },
+                    storage,
+                ),
+            ),
+            Op::BuildTriangleCluster(ref limits) => (2, boxed(triangles(limits), storage)),
+            Op::BuildTriangleClusterTemplate(ref limits) => (3, boxed(triangles(limits), storage)),
+            Op::InstantiateTriangleCluster(ref limits) => (4, boxed(triangles(limits), storage)),
+            Op::GetClusterTemplateIndices(ref limits) => (5, boxed(triangles(limits), storage)),
+        }
+    }
+
+    pub fn input_info(input: &wgt::ClusterAccelerationStructureInput, op_type: i32, op_input: *mut c_void) -> InputInfo {
+        InputInfo {
+            s_type: vk::StructureType::from_raw(1000569005),
+            p_next: core::ptr::null_mut(),
+            max_acceleration_structure_count: input.max_acceleration_structure_count,
+            flags: super::conv::map_acceleration_structure_flags(input.flags),
+            op_type,
+            op_mode: match input.mode {
+                wgt::ClusterOperationMode::ImplicitDestinations => 0,
+                wgt::ClusterOperationMode::ExplicitDestinations => 1,
+                wgt::ClusterOperationMode::ComputeSizes => 2,
+            },
+            op_input,
+        }
+    }
+
+    pub fn partitioned_input(
+        limits: &wgt::PartitionedTlasLimits,
+        flags: crate::AccelerationStructureBuildFlags,
+        partition_flags: &mut PartitionedFlags,
+    ) -> PartitionedInstancesInput {
+        PartitionedInstancesInput {
+            s_type: vk::StructureType::from_raw(1000570003),
+            p_next: partition_flags as *mut PartitionedFlags as *mut c_void,
+            flags: super::conv::map_acceleration_structure_flags(flags),
+            instance_count: limits.instance_count,
+            max_instance_per_partition_count: limits.max_instance_per_partition_count,
+            partition_count: limits.partition_count,
+            max_instance_in_global_partition_count: limits.max_instance_in_global_partition_count,
+        }
+    }
+
+    pub fn partition_flags(limits: &wgt::PartitionedTlasLimits) -> PartitionedFlags {
+        PartitionedFlags {
+            s_type: vk::StructureType::from_raw(1000570005),
+            p_next: core::ptr::null_mut(),
+            enable_partition_translation: limits.enable_partition_translation as vk::Bool32,
+        }
+    }
+}
