+/// Prototype: validates and tracks the buffers of a GPU-driven build, which
+/// reads and writes them by device address, so they need `usage`
+/// (`BLAS_INPUT`, or `STORAGE` for cooperative vector conversions).
+/// Their whole contents count as used (and are zeroed first if never
+/// written), so GPU-written data in them survives.
+fn track_addressed_buffers<'r, 'snatch_guard: 'r>(
+    state: &mut EncodingState<'snatch_guard, '_>,
+    usage: BufferUsages,
+    regions: impl Iterator<Item = &'r AddressedBufferRegion<Arc<Buffer>>>,
+) -> Result<Vec<hal::BufferBarrier<'r, dyn hal::DynBuffer>>, BuildAccelerationStructureError> {
+    let snatch_guard = state.snatch_guard;
+    let mut barriers = Vec::new();
+    for region in regions {
+        let buffer = &region.buffer;
+        buffer.same_device(state.device)?;
+        buffer.check_usage(usage)?;
+        buffer.try_raw(snatch_guard)?;
+        if region
+            .offset
+            .checked_add(region.size)
+            .is_none_or(|end| end > buffer.size)
+        {
+            return Err(BuildAccelerationStructureError::InsufficientBufferSize {
+                buffer_ident: buffer.error_ident(),
+                offset: region.offset,
+                region_size: region.size,
+                buffer_size: buffer.size,
+            });
+        }
+        state
+            .buffer_memory_init_actions
+            .extend(buffer.initialization_status.read().create_action(
+                buffer,
+                0..buffer.size,
+                MemoryInitKind::NeedsInitializedMemory,
+            ));
+        let pending = state
+            .tracker
+            .buffers
+            .set_single(buffer, BufferUses::STORAGE_READ_WRITE);
+        barriers.extend(pending.map(|pending| pending.into_hal(buffer.as_ref(), snatch_guard)));
+    }
+    Ok(barriers)
+}
+
+/// Prototype: `size` `u64::MAX` means the rest of the buffer.
+pub(crate) fn resolve_region_size(
+    mut region: AddressedBufferRegion<Arc<Buffer>>,
+) -> AddressedBufferRegion<Arc<Buffer>> {
+    if region.size == u64::MAX {
+        region.size = region.buffer.size.saturating_sub(region.offset);
+    }
+    region
+}
+
+fn hal_region<'a>(
+    region: &'a AddressedBufferRegion<Arc<Buffer>>,
+    snatch_guard: &'a SnatchGuard,
+) -> Result<hal::BufferRegion<'a, dyn hal::DynBuffer>, BuildAccelerationStructureError> {
+    Ok(hal::BufferRegion {
+        buffer: region.buffer.try_raw(snatch_guard)?,
+        offset: region.offset,
+    })
+}
+
+fn hal_strided_region<'a>(
+    region: &'a AddressedBufferRegion<Arc<Buffer>>,
+    snatch_guard: &'a SnatchGuard,
+) -> Result<hal::StridedBufferRegion<'a, dyn hal::DynBuffer>, BuildAccelerationStructureError> {
+    Ok(hal::StridedBufferRegion {
+        buffer: region.buffer.try_raw(snatch_guard)?,
+        offset: region.offset,
+        stride: region.stride,
+        size: region.size,
+    })
+}
+
+fn scratch_buffer(
+    state: &EncodingState,
+    size: u64,
+) -> Result<ScratchBuffer, BuildAccelerationStructureError> {
+    if size == u64::MAX {
+        return Err(crate::device::DeviceError::OutOfMemory.into());
+    }
+    Ok(ScratchBuffer::new(
+        state.device,
+        wgt::BufferSize::new(size.max(256)).unwrap(),
+    )?)
+}
+
+pub(crate) fn build_cluster_acceleration_structures(
+    state: &mut EncodingState,
+    input: wgt::ClusterAccelerationStructureInput,
+    dst_implicit_data: Option<AddressedBufferRegion<Arc<Buffer>>>,
+    dst_addresses: Option<AddressedBufferRegion<Arc<Buffer>>>,
+    dst_sizes: Option<AddressedBufferRegion<Arc<Buffer>>>,
+    src_infos: AddressedBufferRegion<Arc<Buffer>>,
+    src_infos_count: Option<AddressedBufferRegion<Arc<Buffer>>>,
+) -> Result<(), BuildAccelerationStructureError> {
+    profiling::scope!("build_cluster_acceleration_structures");
+    state
+        .device
+        .require_features(Features::EXPERIMENTAL_CLUSTER_ACCELERATION_STRUCTURE)?;
+    let sizes = unsafe {
+        state
+            .device
+            .raw()
+            .get_cluster_acceleration_structure_build_sizes(&input)
+    };
+    let scratch = scratch_buffer(state, sizes.build_scratch_size)?;
+    {
+        let snatch_guard = state.snatch_guard;
+        let barriers = track_addressed_buffers(
+            state,
+            BufferUsages::BLAS_INPUT,
+            [&dst_implicit_data, &dst_addresses, &dst_sizes, &src_infos_count]
+                .into_iter()
+                .flatten()
+                .chain([&src_infos]),
+        )?;
+        let desc = hal::ClusterAccelerationStructureBuild {
+            input,
+            dst_implicit_data: dst_implicit_data
+                .as_ref()
+                .map(|r| hal_region(r, snatch_guard))
+                .transpose()?,
+            scratch: hal::BufferRegion {
+                buffer: scratch.raw(),
+                offset: 0,
+            },
+            dst_addresses: dst_addresses
+                .as_ref()
+                .map(|r| hal_strided_region(r, snatch_guard))
+                .transpose()?,
+            dst_sizes: dst_sizes
+                .as_ref()
+                .map(|r| hal_strided_region(r, snatch_guard))
+                .transpose()?,
+            src_infos: hal_strided_region(&src_infos, snatch_guard)?,
+            src_infos_count: src_infos_count
+                .as_ref()
+                .map(|r| hal_region(r, snatch_guard))
+                .transpose()?,
+        };
+        unsafe {
+            state.raw_encoder.transition_buffers(&barriers);
+            state.raw_encoder.build_cluster_acceleration_structures(&desc);
+        }
+    }
+    state
+        .temp_resources
+        .push(TempResource::ScratchBuffer(scratch));
+    Ok(())
+}
+
+pub(crate) fn convert_cooperative_vector_matrices(
+    state: &mut EncodingState,
+    conversions: Vec<CooperativeVectorMatrixConversion<Arc<Buffer>>>,
+) -> Result<(), BuildAccelerationStructureError> {
+    profiling::scope!("convert_cooperative_vector_matrices");
+    state
+        .device
+        .require_features(Features::EXPERIMENTAL_COOPERATIVE_VECTOR)?;
+    for conversion in &conversions {
+        let needed = unsafe {
+            state
+                .device
+                .raw()
+                .get_cooperative_vector_matrix_size(&conversion.desc)
+        };
+        if conversion.dst.size < needed {
+            return Err(BuildAccelerationStructureError::InsufficientBufferSize {
+                buffer_ident: conversion.dst.buffer.error_ident(),
+                offset: conversion.dst.offset,
+                region_size: needed,
+                buffer_size: conversion.dst.buffer.size,
+            });
+        }
+    }
+    let snatch_guard = state.snatch_guard;
+    let barriers = track_addressed_buffers(
+        state,
+        BufferUsages::STORAGE,
+        conversions.iter().flat_map(|c| [&c.src, &c.dst]),
+    )?;
+    let hal_conversions = conversions
+        .iter()
+        .map(|c| {
+            Ok(hal::CooperativeVectorMatrixConversion {
+                desc: c.desc,
+                src: hal_region(&c.src, snatch_guard)?,
+                src_size: c.src.size,
+                dst: hal_region(&c.dst, snatch_guard)?,
+                dst_size: c.dst.size,
+            })
+        })
+        .collect::<Result<Vec<_>, BuildAccelerationStructureError>>()?;
+    unsafe {
+        state.raw_encoder.transition_buffers(&barriers);
+        state
+            .raw_encoder
+            .convert_cooperative_vector_matrices(&hal_conversions);
+    }
+    Ok(())
+}
+
+pub(crate) fn build_partitioned_acceleration_structure(
+    state: &mut EncodingState,
+    tlas: Arc<Tlas>,
+    update: bool,
+    src_infos: AddressedBufferRegion<Arc<Buffer>>,
+    src_infos_count: AddressedBufferRegion<Arc<Buffer>>,
+) -> Result<(), BuildAccelerationStructureError> {
+    profiling::scope!("build_partitioned_acceleration_structure");
+    state
+        .device
+        .require_features(Features::EXPERIMENTAL_PARTITIONED_ACCELERATION_STRUCTURE)?;
+    tlas.same_device(state.device)?;
+    let Some(limits) = tlas.partitioned else {
+        return Err(BuildAccelerationStructureError::NotPartitioned(
+            tlas.error_ident(),
+        ));
+    };
+    state.tracker.tlas_s.insert_single(tlas.clone());
+    let scratch = scratch_buffer(
+        state,
+        if update {
+            tlas.size_info.update_scratch_size
+        } else {
+            tlas.size_info.build_scratch_size
+        },
+    )?;
+    {
+        let snatch_guard = state.snatch_guard;
+        let barriers = track_addressed_buffers(
+            state,
+            BufferUsages::BLAS_INPUT,
+            [&src_infos, &src_infos_count].into_iter(),
+        )?;
+        let raw_tlas = tlas.try_raw(snatch_guard)?;
+        let desc = hal::PartitionedAccelerationStructureBuild {
+            limits,
+            flags: tlas.flags,
+            src: update.then_some(raw_tlas),
+            dst: raw_tlas,
+            scratch: hal::BufferRegion {
+                buffer: scratch.raw(),
+                offset: 0,
+            },
+            src_infos: hal_strided_region(&src_infos, snatch_guard)?,
+            src_infos_count: hal_region(&src_infos_count, snatch_guard)?,
+        };
+        unsafe {
+            state.raw_encoder.transition_buffers(&barriers);
+            state.raw_encoder.build_partitioned_acceleration_structure(&desc);
+        }
+    }
+    state
+        .temp_resources
+        .push(TempResource::ScratchBuffer(scratch));
+    // The instances (and the BLASes they refer to) are GPU-written, so the
+    // TLAS has no dependencies to check.
+    state.as_actions.push(AsAction::Build(AsBuild {
+        blas_s_built: Vec::new(),
+        tlas_s_built: alloc::vec![TlasBuild {
+            tlas,
+            dependencies: Vec::new(),
+            max_intersection_idx: None,
+            required_intersection_types: Vec::new(),
+        }],
+    }));
+    Ok(())
+}
