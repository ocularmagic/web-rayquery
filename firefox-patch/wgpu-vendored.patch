+/// Prototype: `VkMicromapUsageEXT`s for opacity micromap usage counts.
+pub fn map_micromap_usage_counts(counts: &[wgt::MicromapUsage]) -> Vec<vk::MicromapUsageEXT> {
+    counts
+        .iter()
+        .map(|usage| vk::MicromapUsageEXT {
+            count: usage.count,
+            subdivision_level: usage.subdivision_level,
+            format: usage.format as u32,
+        })
+        .collect()
+}
+
+pub fn map_micromap_build_flags(
+    flags: crate::AccelerationStructureBuildFlags,
+) -> vk::BuildMicromapFlagsEXT {
+    if flags.contains(crate::AccelerationStructureBuildFlags::PREFER_FAST_BUILD) {
+        vk::BuildMicromapFlagsEXT::PREFER_FAST_BUILD
+    } else {
+        vk::BuildMicromapFlagsEXT::PREFER_FAST_TRACE
+    }
+}
