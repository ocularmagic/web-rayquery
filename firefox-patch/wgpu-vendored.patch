+
+        let mut desc =
+            Self::resolve_render_pipeline_descriptor(shader_modules, pipeline_layouts, desc);
+        desc.cache = Some(cache);
+
+        if !or_error {
+            render_pipelines.assign(id_in, device.create_render_pipeline(desc));
+            return Ok(());
+        }
+        match device.create_render_pipeline_or_error(desc) {
+            Ok(pipeline) => {
+                render_pipelines.assign(id_in, pipeline);
+                Ok(())
+            }
