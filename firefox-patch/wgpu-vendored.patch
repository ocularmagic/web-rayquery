+/// Prototype: `VK_NV_ray_tracing_linear_swept_spheres`, which `ash` 0.38
+/// predates.
+pub(super) mod lss {
+    use ash::vk;
+    use core::ffi::{c_void, CStr};
+
+    pub const NAME: &CStr = c"VK_NV_ray_tracing_linear_swept_spheres";
+    pub const GEOMETRY_TYPE_SPHERES: vk::GeometryTypeKHR = vk::GeometryTypeKHR::from_raw(1000429004);
+    pub const GEOMETRY_TYPE_LINEAR_SWEPT_SPHERES: vk::GeometryTypeKHR =
+        vk::GeometryTypeKHR::from_raw(1000429005);
+    pub const PIPELINE_CREATE_2_ALLOW_SPHERES_AND_LINEAR_SWEPT_SPHERES: vk::PipelineCreateFlags2KHR =
+        vk::PipelineCreateFlags2KHR::from_raw(0x2_0000_0000);
+
+    #[repr(C)]
+    #[derive(Debug)]
+    pub struct Features {
+        pub s_type: vk::StructureType,
+        pub p_next: *mut c_void,
+        pub spheres: vk::Bool32,
+        pub linear_swept_spheres: vk::Bool32,
+    }
+    unsafe impl Send for Features {}
+    unsafe impl Sync for Features {}
+    unsafe impl vk::ExtendsDeviceCreateInfo for Features {}
+    impl Features {
+        pub fn enabled() -> Self {
+            Self {
+                s_type: vk::StructureType::from_raw(1000429008),
+                p_next: core::ptr::null_mut(),
+                spheres: vk::TRUE,
+                linear_swept_spheres: vk::TRUE,
+            }
+        }
+    }
+
+    /// `VkAccelerationStructureGeometrySpheresDataNV` and, with the indexing
+    /// and end cap modes after it,
+    /// `VkAccelerationStructureGeometryLinearSweptSpheresDataNV`.
+    #[repr(C)]
+    pub struct GeometryData {
+        pub s_type: vk::StructureType,
+        pub p_next: *const c_void,
+        pub vertex_format: vk::Format,
+        pub vertex_data: vk::DeviceOrHostAddressConstKHR,
+        pub vertex_stride: vk::DeviceSize,
+        pub radius_format: vk::Format,
+        pub radius_data: vk::DeviceOrHostAddressConstKHR,
+        pub radius_stride: vk::DeviceSize,
+        pub index_type: vk::IndexType,
+        pub index_data: vk::DeviceOrHostAddressConstKHR,
+        pub index_stride: vk::DeviceSize,
+        pub indexing_mode: i32,
+        pub end_caps_mode: i32,
+    }
+
+    /// The `pNext` data of a sphere geometry; `address` maps a buffer to its
+    /// device address (0 when only sizing).
+    pub fn geometry_data(
+        spheres: &crate::AccelerationStructureSpheres<super::Buffer>,
+        address: &dyn Fn(Option<&super::Buffer>) -> vk::DeviceAddress,
+    ) -> alloc::boxed::Box<GeometryData> {
+        let (index_type, index_data, index_stride) = match spheres.indices {
+            Some(ref indices) => (
+                super::conv::map_index_format(indices.format),
+                address(indices.buffer) + u64::from(indices.offset),
+                match indices.format {
+                    wgt::IndexFormat::Uint16 => 2,
+                    wgt::IndexFormat::Uint32 => 4,
+                },
+            ),
+            None => (vk::IndexType::NONE_KHR, 0, 0),
+        };
+        alloc::boxed::Box::new(GeometryData {
+            s_type: vk::StructureType::from_raw(if spheres.linear_swept.is_some() {
+                1000429009
+            } else {
+                1000429010
+            }),
+            p_next: core::ptr::null(),
+            vertex_format: vk::Format::R32G32B32_SFLOAT,
+            vertex_data: vk::DeviceOrHostAddressConstKHR {
+                device_address: address(spheres.vertex_buffer) + spheres.vertex_offset,
+            },
+            vertex_stride: spheres.vertex_stride,
+            radius_format: vk::Format::R32_SFLOAT,
+            radius_data: vk::DeviceOrHostAddressConstKHR {
+                device_address: address(spheres.radius_buffer) + spheres.radius_offset,
+            },
+            radius_stride: spheres.radius_stride,
+            index_type,
+            index_data: vk::DeviceOrHostAddressConstKHR {
+                device_address: index_data,
+            },
+            index_stride,
+            indexing_mode: spheres.linear_swept.map_or(0, |l| l.successive as i32),
+            end_caps_mode: spheres.linear_swept.map_or(0, |l| l.chained_end_caps as i32),
+        })
+    }
+
+    pub fn geometry_type(spheres: &crate::AccelerationStructureSpheres<super::Buffer>) -> vk::GeometryTypeKHR {
+        if spheres.linear_swept.is_some() {
+            GEOMETRY_TYPE_LINEAR_SWEPT_SPHERES
+        } else {
+            GEOMETRY_TYPE_SPHERES
+        }
+    }
+}
