+                        radius_stride: sphere.radius_stride,
+                        indices,
+                        linear_swept: size_desc.linear_swept,
+                        primitive_count: size_desc.primitive_count(),
+                        flags: size_desc.flags,
+                    });
+                }
+
+                let scratch_buffer_offset = *scratch_buffer_blas_size;
+                *scratch_buffer_blas_size = scratch_buffer_blas_size.saturating_add(align_to(
+                    blas.size_info.build_scratch_size,
+                    u64::from(state.device.alignments.ray_tracing_scratch_buffer_alignment),
+                ));
+                blas_storage.push(BlasStore {
+                    blas: blas.clone(),
+                    entries: hal::AccelerationStructureEntries::Spheres(sphere_entries),
+                    scratch_buffer_offset,
+                });
+            }
+            ArcBlasGeometries::OpacityMicromap(micromap) => {
+                let wgt::BlasGeometrySizeDescriptors::OpacityMicromap { usage_counts } = &blas.sizes
+                else {
+                    return Err(BuildAccelerationStructureError::BlasGeometryKindMismatch(
+                        blas.error_ident(),
+                    ));
+                };
+                let mut raw_input = |buffer: &'buffers Arc<Buffer>, offset| {
+                    let pending = state.tracker.buffers.set_single(
+                        buffer,
+                        BufferUses::BOTTOM_LEVEL_ACCELERATION_STRUCTURE_INPUT,
+                    );
+                    let raw = buffer.try_raw(state.snatch_guard)?;
+                    buffer.check_usage(BufferUsages::BLAS_INPUT)?;
+                    if let Some(barrier) =
+                        pending.map(|pending| pending.into_hal(buffer.as_ref(), state.snatch_guard))
+                    {
+                        input_barriers.push(barrier);
+                    }
+                    state.buffer_memory_init_actions.extend(
+                        buffer.initialization_status.read().create_action(
+                            buffer,
+                            offset..buffer.size,
+                            MemoryInitKind::NeedsInitializedMemory,
+                        ),
+                    );
+                    Ok::<_, BuildAccelerationStructureError>(raw)
+                };
+                let data_raw = raw_input(&micromap.data_buffer, micromap.data_offset)?;
+                let triangle_raw = raw_input(&micromap.triangle_buffer, micromap.triangle_offset)?;
+
+                let scratch_buffer_offset = *scratch_buffer_blas_size;
+                *scratch_buffer_blas_size = scratch_buffer_blas_size.saturating_add(align_to(
+                    blas.size_info.build_scratch_size,
+                    u64::from(state.device.alignments.ray_tracing_scratch_buffer_alignment),
+                ));
+                blas_storage.push(BlasStore {
+                    blas: blas.clone(),
+                    entries: hal::AccelerationStructureEntries::OpacityMicromap(
+                        hal::AccelerationStructureOpacityMicromap {
+                            data_buffer: Some(data_raw),
+                            data_offset: micromap.data_offset,
+                            triangle_buffer: Some(triangle_raw),
+                            triangle_offset: micromap.triangle_offset,
+                            usage_counts,
+                        },
+                    ),
+                    scratch_buffer_offset,
+                });
+            }
         }
     }
     Ok(())
