+                    | crate::AddressSpace::CallableData
+                    | crate::AddressSpace::IncomingCallableData
+                    | crate::AddressSpace::RayHitAttribute
+            ) {
+                continue;
+            }
+            let name = self.namer.call(&format!(
+                "{}_rt",
+                self.names[&NameKey::GlobalVariable(handle)]
+            ));
