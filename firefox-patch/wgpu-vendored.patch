+/// Prototype: the `pNext` attachment for a triangle geometry's opacity
+/// micromap, with the usage counts it points to. `index_address` is the
+/// micromap index buffer's device address, or 0 when only sizing.
+pub fn map_triangle_opacity_micromap(
+    micromap: &crate::AccelerationStructureTriangleOpacityMicromap<super::Buffer>,
+    index_address: vk::DeviceAddress,
+) -> (
+    Box<vk::AccelerationStructureTrianglesOpacityMicromapEXT<'static>>,
+    Vec<vk::MicromapUsageEXT>,
+) {
+    let usage_counts = map_micromap_usage_counts(micromap.usage_counts);
+    let raw_micromap = micromap
+        .micromap
+        .map(|m| {
+            m.as_any()
+                .downcast_ref::<super::AccelerationStructure>()
+                .expect("Resource doesn't have the expected backend type.")
+                .micromap
+        })
+        .unwrap_or(vk::MicromapEXT::null());
+    let attachment = Box::new(vk::AccelerationStructureTrianglesOpacityMicromapEXT {
+        index_type: map_index_format(micromap.index_format),
+        index_buffer: vk::DeviceOrHostAddressConstKHR {
+            device_address: index_address,
+        },
+        index_stride: match micromap.index_format {
+            wgt::IndexFormat::Uint16 => 2,
+            wgt::IndexFormat::Uint32 => 4,
+        },
+        base_triangle: micromap.base_triangle,
+        usage_counts_count: usage_counts.len() as u32,
+        p_usage_counts: usage_counts.as_ptr(),
+        micromap: raw_micromap,
+        ..Default::default()
+    });
+    (attachment, usage_counts)
+}
