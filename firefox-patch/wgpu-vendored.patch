+
+    /// `VkConvertCooperativeVectorMatrixInfoNV`.
+    #[repr(C)]
+    pub struct ConvertInfo {
+        pub s_type: vk::StructureType,
+        pub p_next: *const c_void,
+        pub src_size: usize,
+        pub src_data: vk::DeviceOrHostAddressConstKHR,
+        pub p_dst_size: *mut usize,
+        pub dst_data: vk::DeviceOrHostAddressKHR,
+        pub src_component_type: u32,
+        pub dst_component_type: u32,
+        pub num_rows: u32,
+        pub num_columns: u32,
+        pub src_layout: u32,
+        pub src_stride: usize,
+        pub dst_layout: u32,
+        pub dst_stride: usize,
+    }
+
+    /// `VkCooperativeVectorPropertiesNV`.
+    #[repr(C)]
+    pub struct Properties {
+        pub s_type: vk::StructureType,
+        pub p_next: *mut c_void,
+        pub input_type: u32,
+        pub input_interpretation: u32,
+        pub matrix_interpretation: u32,
+        pub bias_interpretation: u32,
+        pub result_type: u32,
+        pub transpose: vk::Bool32,
+    }
+
+    pub type Convert = unsafe extern "system" fn(vk::Device, *const ConvertInfo) -> vk::Result;
+    pub type CmdConvert = unsafe extern "system" fn(vk::CommandBuffer, u32, *const ConvertInfo);
+    pub type GetProperties =
+        unsafe extern "system" fn(vk::PhysicalDevice, *mut u32, *mut Properties) -> vk::Result;
+
+    pub struct Fns {
+        pub convert: Convert,
+        pub cmd_convert: CmdConvert,
+        pub get_properties: Option<GetProperties>,
+    }
+
+    /// A conversion of `desc`, with no data yet.
+    pub fn convert_info(desc: &wgt::CooperativeVectorMatrixConversionDescriptor) -> ConvertInfo {
+        // Row- and column-major matrices take whole rows or columns.
+        let src_size = match desc.src.layout {
+            0 => desc.src.stride * u64::from(desc.rows),
+            1 => desc.src.stride * u64::from(desc.columns),
+            _ => 0,
+        };
+        ConvertInfo {
+            s_type: vk::StructureType::from_raw(1000491004),
+            p_next: core::ptr::null(),
+            src_size: src_size as usize,
+            src_data: vk::DeviceOrHostAddressConstKHR { device_address: 0 },
+            p_dst_size: core::ptr::null_mut(),
+            dst_data: vk::DeviceOrHostAddressKHR { device_address: 0 },
+            src_component_type: desc.src.component_type,
+            dst_component_type: desc.dst.component_type,
+            num_rows: desc.rows,
+            num_columns: desc.columns,
+            src_layout: desc.src.layout,
+            src_stride: desc.src.stride as usize,
+            dst_layout: desc.dst.layout,
+            dst_stride: desc.dst.stride as usize,
+        }
+    }
