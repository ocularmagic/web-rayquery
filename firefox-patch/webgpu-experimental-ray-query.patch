+// Prototype: hardware ray queries.
+
+/// `GPUBufferUsage.BLAS_INPUT`: a bit WebGPU does not use (see WebGPU.webidl).
+const BLAS_INPUT_USAGE_BIT: u32 = 0x4000_0000;
+
+impl Global {
+    /// Like `device_create_buffer`, with `BLAS_INPUT_USAGE_BIT` replaced by
+    /// wgpu's native `BufferUsages::BLAS_INPUT`, which `wgpu_core_remote`
+    /// never sets.
+    fn device_create_buffer_with_blas_input(
+        &self,
+        device_id: id::DeviceId,
+        desc: &BufferDescriptor,
+        id_in: id::BufferId,
+    ) {
+        let device = self.resolve_device_id(device_id);
+        let usage = wgt::BufferUsages::from_internal_flags(
+            wgt::BufferUsagesWebGPU::from_bits_retain(desc.usage.bits() & !BLAS_INPUT_USAGE_BIT),
+            wgt::BufferUsagesWGPU::BLAS_INPUT,
+        );
+        let desc = wgc::resource::BufferDescriptor {
+            label: desc.label.as_deref().map(Cow::Borrowed),
+            size: desc.size,
+            usage,
+            mapped_at_creation: desc.mapped_at_creation,
+        };
+        let buffer = device.create_buffer(&desc);
+        self.import_buffer(buffer, id_in);
+    }
+
+    /// Like `device_create_bind_group`, plus `(binding, tlas)` entries, which
+    /// `wgpu_core_remote`'s bind group descriptor cannot express.
+    fn create_bind_group_with_tlas(
+        &self,
+        device_id: id::DeviceId,
+        id_in: id::BindGroupId,
+        desc: wgpu_core_remote_types::binding_model::BindGroupDescriptor<'static>,
+        tlas_entries: Vec<(u32, id::TlasId)>,
+    ) {
+        use wgc::binding_model as bm;
+        use wgpu_core_remote_types::binding_model::BindingResource;
+
+        let device = self.resolve_device_id(device_id);
+        let layout = self.resolve_bind_group_layout_id(desc.layout);
+
+        let mut entries = Vec::with_capacity(desc.entries.len() + tlas_entries.len());
+        for entry in desc.entries.iter() {
+            let resource = match &entry.resource {
+                BindingResource::Buffer(b) => bm::BindingResource::Buffer(bm::BufferBinding {
+                    buffer: self.resolve_buffer_id(b.buffer),
+                    offset: b.offset,
+                    size: b.size.to_std(),
+                }),
+                BindingResource::Sampler(id) => {
+                    bm::BindingResource::Sampler(self.resolve_sampler_id(*id))
+                }
+                BindingResource::TextureView(id) => {
+                    bm::BindingResource::TextureView(self.resolve_texture_view_id(*id))
+                }
+                BindingResource::ExternalTexture(id) => {
+                    bm::BindingResource::ExternalTexture(self.resolve_external_texture_id(*id))
+                }
+            };
+            entries.push(bm::BindGroupEntry {
+                binding: entry.binding,
+                resource,
+            });
+        }
+        {
+            let tlases = self.tlases.lock().unwrap();
+            for (binding, tlas_id) in tlas_entries {
+                match tlases.get(&tlas_id) {
+                    Some(tlas) => entries.push(bm::BindGroupEntry {
+                        binding,
+                        resource: bm::BindingResource::AccelerationStructure(tlas.clone()),
+                    }),
+                    // Leave the entry out; wgpu-core then reports the missing
+                    // binding as a validation error.
+                    None => GPUError {
+                        message: format!("Unknown GPUTlas for binding {binding}").into(),
+                        r#type: ErrorType::Validation,
+                    }
+                    .report(self, device_id),
+                }
+            }
+        }
+
+        let desc = bm::BindGroupDescriptor {
+            label: desc.label.clone(),
+            layout,
+            entries: Cow::Owned(entries),
+        };
+        let bind_group = device.create_bind_group(&desc);
+        self.import_bind_group(bind_group, id_in);
+    }
+
+    fn build_acceleration_structures(
+        &self,
+        command_encoder_id: id::CommandEncoderId,
+        blas: Vec<crate::BlasBuildEntry>,
+        tlas: Vec<crate::TlasBuildEntry>,
+    ) {
+        use wgc::ray_tracing as rt;
+
+        struct Geometry {
+            size: wgt::BlasTriangleGeometrySizeDescriptor,
+            vertex_buffer: Arc<wgc::resource::Buffer>,
+            first_vertex: u32,
+            vertex_stride: wgt::BufferAddress,
+            index_buffer: Option<Arc<wgc::resource::Buffer>>,
+            first_index: Option<u32>,
+        }
+
+        let encoder = self.resolve_command_encoder_id(command_encoder_id);
+
+        // Resolve every id first.
+        let mut blas_entries = Vec::with_capacity(blas.len());
+        let mut tlas_packages = Vec::with_capacity(tlas.len());
+        {
+            let blases = self.blases.lock().unwrap();
+            let tlases = self.tlases.lock().unwrap();
+            for entry in blas {
+                let Some(blas) = blases.get(&entry.blas) else {
+                    log::error!("build_acceleration_structures: unknown BLAS {:?}", entry.blas);
+                    return;
+                };
+                let geometries = entry
+                    .geometries
+                    .into_iter()
+                    .map(|g| Geometry {
+                        size: g.size,
+                        vertex_buffer: self.resolve_buffer_id(g.vertex_buffer),
+                        first_vertex: g.first_vertex,
+                        vertex_stride: g.vertex_stride,
+                        index_buffer: g.index_buffer.map(|id| self.resolve_buffer_id(id)),
+                        first_index: g.first_index,
+                    })
+                    .collect::<Vec<_>>();
+                blas_entries.push((blas.clone(), geometries));
+            }
+            for entry in tlas {
+                let Some(tlas) = tlases.get(&entry.tlas) else {
+                    log::error!("build_acceleration_structures: unknown TLAS {:?}", entry.tlas);
+                    return;
+                };
+                let mut instances = Vec::with_capacity(entry.instances.len());
+                for instance in entry.instances {
+                    let Some(blas) = blases.get(&instance.blas) else {
+                        log::error!(
+                            "build_acceleration_structures: unknown BLAS {:?} in TLAS instance",
+                            instance.blas
+                        );
+                        return;
+                    };
+                    instances.push(Some(rt::ArcTlasInstance {
+                        blas: blas.clone(),
+                        transform: instance.transform,
+                        custom_data: instance.custom_data,
+                        mask: instance.mask,
+                    }));
+                }
+                tlas_packages.push(rt::ArcTlasPackage {
+                    tlas: tlas.clone(),
+                    instances,
+                    lowest_unmodified: 0,
+                });
+            }
+        }
+
+        let blas_iter = blas_entries.iter().map(|(blas, geometries)| rt::BlasBuildEntry {
+            blas: blas.clone(),
+            geometries: rt::BlasGeometries::TriangleGeometries(Box::new(geometries.iter().map(
+                |g| rt::BlasTriangleGeometry {
+                    size: &g.size,
+                    vertex_buffer: g.vertex_buffer.clone(),
+                    index_buffer: g.index_buffer.clone(),
+                    transform_buffer: None,
+                    first_vertex: g.first_vertex,
+                    vertex_stride: g.vertex_stride,
+                    first_index: g.first_index,
+                    transform_buffer_offset: None,
+                },
+            ))),
+        });
+        encoder.build_acceleration_structures(blas_iter, tlas_packages);
+    }
+}
