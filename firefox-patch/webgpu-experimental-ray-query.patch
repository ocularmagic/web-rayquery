+// Prototype: hardware ray queries. wgpu-core validates the feature, sizes and
+// limits, and reports errors to the device.
+
+already_AddRefed<Blas> Device::CreateBlas(const dom::GPUBlasDescriptor& aDesc) {
+  nsTArray<ffi::WGPUFfiBlasTriangleGeometrySize> sizes(
+      aDesc.mGeometries.Length());
+  for (const auto& geometry : aDesc.mGeometries) {
+    ffi::WGPUFfiBlasTriangleGeometrySize size = {};
+    size.vertex_format = ConvertVertexFormat(geometry.mVertexFormat);
+    size.vertex_count = geometry.mVertexCount;
+    size.has_index = geometry.mIndexFormat.WasPassed();
+    if (size.has_index) {
+      size.index_format =
+          geometry.mIndexFormat.Value() == dom::GPUIndexFormat::Uint32
+              ? ffi::WGPUIndexFormat_Uint32
+              : ffi::WGPUIndexFormat_Uint16;
+      size.index_count =
+          geometry.mIndexCount.WasPassed() ? geometry.mIndexCount.Value() : 0;
+    }
+    size.opaque = geometry.mOpaque;
+    sizes.AppendElement(size);
+  }
+
+  webgpu::StringHelper label(aDesc.mLabel);
+  RawId id = ffi::wgpu_client_create_blas(GetClient(), GetId(), label.Get(),
+                                          {sizes.Elements(), sizes.Length()});
+
+  RefPtr<Blas> blas = new Blas(this, id, std::move(sizes));
+  blas->SetLabel(aDesc.mLabel);
+  return blas.forget();
+}
+
+already_AddRefed<Tlas> Device::CreateTlas(const dom::GPUTlasDescriptor& aDesc) {
+  webgpu::StringHelper label(aDesc.mLabel);
+  RawId id = ffi::wgpu_client_create_tlas(GetClient(), GetId(), label.Get(),
+                                          aDesc.mMaxInstances);
+
+  RefPtr<Tlas> tlas = new Tlas(this, id, aDesc.mMaxInstances);
+  tlas->SetLabel(aDesc.mLabel);
+  return tlas.forget();
+}
