+    required GPUSize64 vertexStride;
+    GPUBuffer indexBuffer;
+    GPUSize32 firstIndex = 0;
+};
+
+dictionary GPUBlasBuildEntry {
+    required GPUBlas blas;
+    required sequence<GPUBlasTriangleGeometry> geometries;
+};
+
+dictionary GPUTlasInstance {
+    required GPUBlas blas;
+    // Row-major 3x4 matrix (12 numbers). Defaults to identity.
+    sequence<float> transform;
+    GPUSize32 customData = 0;
+    [EnforceRange] octet mask = 255;
+};
+
+dictionary GPUTlasBuildEntry {
+    required GPUTlas tlas;
+    required sequence<GPUTlasInstance> instances;
