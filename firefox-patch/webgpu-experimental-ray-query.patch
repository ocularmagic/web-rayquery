+ Exposed=(Window, Worker), SecureContext]
+interface GPUBlas {
+};
+GPUBlas includes GPUObjectBase;
+
+// Top-level acceleration structure: instances of BLASes.
+[Func="mozilla::webgpu::Instance::RayQueryPrefEnabled",
+ Exposed=(Window, Worker), SecureContext]
+interface GPUTlas {
+    readonly attribute GPUSize32Out maxInstances;
+};
+GPUTlas includes GPUObjectBase;
+
+// The size of one triangle geometry in a BLAS. A build must pass geometries
+// in the same order, with at most these counts.
+dictionary GPUBlasTriangleGeometrySize {
+    GPUVertexFormat vertexFormat = "float32x3";
+    required GPUSize32 vertexCount;
+    GPUIndexFormat indexFormat;
+    GPUSize32 indexCount;
+    boolean opaque = true;
+};
+
+dictionary GPUBlasDescriptor
+         : GPUObjectDescriptorBase {
+    required sequence<GPUBlasTriangleGeometrySize> geometries;
+};
+
+dictionary GPUTlasDescriptor
+         : GPUObjectDescriptorBase {
+    required GPUSize32 maxInstances;
+};
+
