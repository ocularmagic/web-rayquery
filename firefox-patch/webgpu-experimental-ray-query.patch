+/// Prototype: convert a bind group layout entry to the `wgt` type, which can
+/// also describe acceleration structures. An entry with no type set is an
+/// acceleration structure (see `RawBindingType::AccelerationStructure`).
+fn bgl_entry_to_wgt(entry: &BindGroupLayoutEntry) -> wgt::BindGroupLayoutEntry {
+    let ty = if let Some(b) = entry.buffer.to_std() {
+        wgt::BindingType::Buffer {
+            ty: b.ty,
+            has_dynamic_offset: b.has_dynamic_offset,
+            min_binding_size: b.min_binding_size,
+        }
+    } else if let Some(s) = entry.sampler.to_std() {
+        wgt::BindingType::Sampler(s.ty)
+    } else if let Some(t) = entry.texture.to_std() {
+        wgt::BindingType::Texture {
+            sample_type: t.sample_type,
+            view_dimension: t.view_dimension,
+            multisampled: t.multisampled,
+        }
+    } else if let Some(s) = entry.storage_texture.to_std() {
+        wgt::BindingType::StorageTexture {
+            access: s.access,
+            format: s.format,
+            view_dimension: s.view_dimension,
+        }
+    } else if entry.external_texture {
+        wgt::BindingType::ExternalTexture
+    } else {
+        wgt::BindingType::AccelerationStructure {
+            vertex_return: false,
+        }
+    };
+    wgt::BindGroupLayoutEntry {
+        binding: entry.binding,
+        visibility: wgt::ShaderStages::from_internal_flags(
+            entry.visibility,
+            wgt::ShaderStagesWGPU::empty(),
+        ),
+        ty,
+        count: None,
+    }
+}
